1	#!/usr/bin/env python3
     2	"""notify-digest — poll a few feeds, filter them, send digests to channels.
     3	
     4	Run from cron. See README.md.
     5	"""
     6	
     7	import argparse
     8	import sys
     9	import tomllib
    10	from pathlib import Path
    11	
    12	import channels
    13	import feeds
    14	import render
    15	import store
    16	
    17	
    18	def load_config(path):
    19	    with open(path, "rb") as fh:
    20	        return tomllib.load(fh)
    21	
    22	
    23	def matches(item, filt):
    24	    """A channel filter is a list of keywords; empty list means 'everything'."""
    25	    keywords = filt.get("keywords", [])
    26	    if not keywords:
    27	        return True
    28	    haystack = (item["title"] + " " + item.get("summary", "")).lower()
    29	    return any(k.lower() in haystack for k in keywords)
    30	
    31	
    32	def _dedup_id(item):
    33	    """Return the deduplication key for an item.
    34	
    35	    Some feeds have no stable raw_id (blogroll) or regenerate it on edits
    36	    (generic).  We fall back to the link URL which is the most stable
    37	    identifier available across all providers.
    38	    """
    39	    return item.get("raw_id") or item["link"]
    40	
    41	
    42	def run_once(cfg, db, dry_run=False):
    43	    all_items = []
    44	    for feed_cfg in cfg["feeds"]:
    45	        try:
    46	            items = feeds.fetch(feed_cfg)
    47	        except feeds.FeedError as exc:
    48	            print(f"warn: feed {feed_cfg['name']} failed: {exc}", file=sys.stderr)
    49	            continue
    50	        store.record_items(db, feed_cfg["name"], items)
    51	        all_items.extend(items)
    52	
    53	    all_items.sort(key=lambda i: i.get("published", ""), reverse=True)
    54	
    55	    sent = 0
    56	    for chan_cfg in cfg["channels"]:
    57	        chan_name = chan_cfg["name"]
    58	        selected = [
    59	            i for i in all_items
    60	            if matches(i, chan_cfg)
    61	            and not store.is_sent(db, i["source"], _dedup_id(i), chan_name)
    62	        ]
    63	        if not selected:
    64	            continue
    65	        body = render.digest(selected, chan_cfg)
    66	        if dry_run:
    67	            print(f"--- would send to {chan_name} ---")
    68	            print(body)
    69	            continue
    70	        channels.send(chan_cfg, body)
    71	        for i in selected:
    72	            store.mark_sent(db, i["source"], _dedup_id(i), chan_name)
    73	        sent += len(selected)
    74	
    75	    return sent
    76	
    77	
    78	def main(argv=None):
    79	    ap = argparse.ArgumentParser(prog="digest")
    80	    ap.add_argument("--config", default="config.toml")
    81	    ap.add_argument("--db", default="digest.sqlite3")
    82	    ap.add_argument("--dry-run", action="store_true")
    83	    args = ap.parse_args(argv)
    84	
    85	    cfg = load_config(args.config)
    86	    db = store.connect(args.db)
    87	    try:
    88	        sent = run_once(cfg, db, dry_run=args.dry_run)
    89	        print(f"sent {sent} items")
    90	    finally:
    91	        db.close()
    92	    return 0
    93	
    94	
    95	if __name__ == "__main__":
    96	    raise SystemExit(main())
