     1	#!/usr/bin/env python3
     2	"""notify-digest — poll a few feeds, filter them, send digests to channels.
     3	
     4	Run from cron. See README.md.
     5	"""
     6	
     7	import argparse
     8	import sys
     9	import tomllib
    10	from pathlib import Path
    11	
    12	import channels
    13	import feeds
    14	import render
    15	import store
    16	
    17	
    18	def load_config(path):
    19	    with open(path, "rb") as fh:
    20	        return tomllib.load(fh)
    21	
    22	
    23	def matches(item, filt):
    24	    """A channel filter is a list of keywords; empty list means 'everything'."""
    25	    keywords = filt.get("keywords", [])
    26	    if not keywords:
    27	        return True
    28	    haystack = (item["title"] + " " + item.get("summary", "")).lower()
    29	    return any(k.lower() in haystack for k in keywords)
    30	
    31	
    32	def run_once(cfg, db, dry_run=False):
    33	    all_items = []
    34	    for feed_cfg in cfg["feeds"]:
    35	        try:
    36	            items = feeds.fetch(feed_cfg)
    37	        except feeds.FeedError as exc:
    38	            print(f"warn: feed {feed_cfg['name']} failed: {exc}", file=sys.stderr)
    39	            continue
    40	        store.record_items(db, feed_cfg["name"], items)
    41	        all_items.extend(items)
    42	
    43	    all_items.sort(key=lambda i: i.get("published", ""), reverse=True)
    44	
    45	    sent = 0
    46	    for chan_cfg in cfg["channels"]:
    47	        selected = [i for i in all_items if matches(i, chan_cfg)]
    48	        if not selected:
    49	            continue
    50	        body = render.digest(selected, chan_cfg)
    51	        if dry_run:
    52	            print(f"--- would send to {chan_cfg['name']} ---")
    53	            print(body)
    54	            continue
    55	        channels.send(chan_cfg, body)
    56	        sent += len(selected)
    57	
    58	    return sent
    59	
    60	
    61	def main(argv=None):
    62	    ap = argparse.ArgumentParser(prog="digest")
    63	    ap.add_argument("--config", default="config.toml")
    64	    ap.add_argument("--db", default="digest.sqlite3")
    65	    ap.add_argument("--dry-run", action="store_true")
    66	    args = ap.parse_args(argv)
    67	
    68	    cfg = load_config(args.config)
    69	    db = store.connect(args.db)
    70	    try:
    71	        sent = run_once(cfg, db, dry_run=args.dry_run)
    72	        print(f"sent {sent} items")
    73	    finally:
    74	        db.close()
    75	    return 0
    76	
    77	
    78	if __name__ == "__main__":
    79	    raise SystemExit(main())
