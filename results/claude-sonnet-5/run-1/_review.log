import digest, store, channels
from unittest.mock import patch

cfg = digest.load_config('config.toml')
db = store.connect('crash_test.sqlite3')

call_count = {'n': 0}
orig_send = channels.send
def flaky_send(chan_cfg, body):
    call_count['n'] += 1
    if chan_cfg['name'] == 'energy':
        raise channels.DeliveryError('simulated outage')
    return orig_send(chan_cfg, body)

with patch('digest.channels.send', flaky_send):
    try:
        digest.run_once(cfg, db)
    except channels.DeliveryError as e:
        print('caught expected crash:', e)

# check what got marked
print('ops sent-marked:', len(store.already_sent(db, 'ops', [('newsroom','x')])) >= 0)
cur = db.execute('SELECT channel, count(*) FROM sent GROUP BY channel').fetchall()
for r in cur:
    print(dict(r))
"

