timestamp=2026-08-26T17:14:42.944Z level=INFO run=110a6874 message=evaluated permission=bash pattern="python3 - <<'EOF'\nimport pathlib, subprocess, os\n\nbase = pathlib.Path(\"config.example.toml\").read_text()\n# channel that will fail (unroutable), plus a good one before it\nbad = base + '''\n[[channels]]\nname = \"broken\"\ntype = \"webhook\"\nurl = \"http://127.0.0.1:9/nope\"\nkeywords = []\n'''\npathlib.Path(\"/tmp/dg-bad.toml\").write_text(bad)\n\ndb = \"/tmp/dg-test2.sqlite3\"\nif os.path.exists(db): os.remove(db)\n\ndef run(cfg):\n    r = subprocess.run([\"python3\",\"digest.py\",\"--config\",cfg,\"--db\",db],\n                       capture_output=True, text=True)\n    return r.returncode, r.stdout, r.stderr\n\nrc,out,err = run(\"/tmp/dg-bad.toml\")\nprint(\"run1 rc:\", rc, \"| DeliveryError seen:\", \"DeliveryError\" in err)\n\n# dry-run must not mark anything as sent\nrc,out,err = run(\"/tmp/dg-a.toml\")\nprint(\"dry-run after failed run still offers items:\", \"would send\" in out or \"=== ops\" in out)\nEOF" action.permission=* action.action=allow action.pattern=*
