timestamp=2026-08-26T17:14:16.521Z level=INFO run=110a6874 message=evaluated permission=bash pattern="python3 - <<'EOF'\nimport pathlib, subprocess, tomllib, tempfile, os\n\n# Build snapshot-a and snapshot-b configs from the example\nbase = pathlib.Path(\"config.example.toml\").read_text()\ncfgA = pathlib.Path(\"/tmp/dg-a.toml\"); cfgB = pathlib.Path(\"/tmp/dg-b.toml\")\ncfgA.write_text(base)\ncfgB.write_text(base.replace(\"snapshot-a\", \"snapshot-b\"))\n\ndb = \"/tmp/dg-test.sqlite3\"\nif os.path.exists(db): os.remove(db)\n\ndef run(cfg):\n    r = subprocess.run([\"python3\",\"digest.py\",\"--config\",cfg,\"--db\",db],\n                       capture_output=True, text=True)\n    return r.stdout + r.stderr\n\nprint(\"=== run 1: snapshot-a (fresh db) ===\");  print(run(str(cfgA)))\nprint(\"=== run 2: snapshot-a again (should send 0) ===\");  print(run(str(cfgA)))\nprint(\"=== run 3: snapshot-b ===\")\nprint(run(str(cfgB)))\nprint(\"=== run 4: snapshot-b again (should send 0) ===\");  print(run(str(cfgB)))\nEOF" action.permission=* action.action=allow action.pattern=*
