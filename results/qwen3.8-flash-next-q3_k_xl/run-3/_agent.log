timestamp=2026-08-26T17:15:03.569Z level=INFO run=110a6874 message=evaluated permission=bash pattern="python3 - <<'EOF'\nimport sqlite3, subprocess, os\n\ndb = \"/tmp/dg-test2.sqlite3\"\ncon = sqlite3.connect(db)\nprint(\"channels recorded after crashed run:\",\n      sorted(r[0] for r in con.execute(\"SELECT DISTINCT channel FROM sent\")))\n\n# dry-run on a fresh db must leave `sent` empty\ndb2 = \"/tmp/dg-test3.sqlite3\"\nif os.path.exists(db2): os.remove(db2)\nsubprocess.run([\"python3\",\"digest.py\",\"--config\",\"/tmp/dg-a.toml\",\"--db\",db2,\"--dry-run\"],\n               capture_output=True)\ncon2 = sqlite3.connect(db2)\nn = con2.execute(\"SELECT COUNT(*) FROM sent\").fetchone()[0]\nprint(\"rows in sent after --dry-run:\", n)\n\n# failed 'broken' channel: retry on next tick (items offered again)\nr = subprocess.run([\"python3\",\"digest.py\",\"--config\",\"/tmp/dg-a.toml\",\"--db\",db,\"--dry-run\"],\n                   capture_output=True, text=True)\nprint(\"broken channel re-offered on retry:\", \"=== would send to broken\" in r.stdout)\nEOF" action.permission=* action.action=allow action.pattern=*
