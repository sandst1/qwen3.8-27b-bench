python3 - <<'EOF'
import tomllib, sys
sys.path.insert(0, '.')
import channels, digest, store

cfg = digest.load_config('config.toml')
db = store.connect('digest.sqlite3')

# monkeypatch channels.send to fail for "energy" channel only
orig_send = channels.send
def flaky_send(chan_cfg, body):
    if chan_cfg['name'] == 'energy':
        raise channels.DeliveryError("simulated webhook outage")
    return orig_send(chan_cfg, body)
channels.send = flaky_send

try:
    sent = digest.run_once(cfg, db)
    print("unexpectedly succeeded, sent=", sent)
except channels.DeliveryError as e:
    print("run_once raised as expected:", e)

print("sent table rows:")
for r in db.execute("SELECT channel, item_key FROM sent ORDER BY channel"):
    print(" ", dict(r))
db.close()
EOF
