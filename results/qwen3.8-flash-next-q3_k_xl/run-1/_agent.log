timestamp=2026-08-26T17:02:39.246Z level=INFO run=a8ba8c5d message=evaluated permission=bash pattern="cat > /var/folders/p4/n0xz6vp14wq0xc0ktf097vhw0000gn/T/bench-qwen3.8-flash-next-q3_k_xl-1-umkd0bf2/notify-digest/_verify_dedup.py <<'PY'\nimport io, sys, tempfile, os\nfrom contextlib import redirect_stdout\nimport store, digest\n\ndef cfg(snap):\n    base = f\"file://fixtures/{snap}\"\n    return {\n        \"feeds\": [\n            {\"name\": \"newsroom\", \"format\": \"newsroom\", \"url\": f\"{base}/newsroom.json\"},\n            {\"name\": \"blogroll\", \"format\": \"blogroll\", \"url\": f\"{base}/blogroll.json\"},\n            {\"name\": \"wire\", \"format\": \"generic\", \"url\": f\"{base}/wire.json\"},\n        ],\n        \"channels\": [\n            {\"name\": \"ops\", \"type\": \"stdout\", \"title\": \"Ops\", \"keywords\": [\"port\", \"levy\", \"fee\"]},\n            {\"name\": \"energy\", \"type\": \"stdout\", \"title\": \"Energy\", \"keywords\": [\"tender\", \"grid\", \"offshore\"]},\n            {\"name\": \"everything\", \"type\": \"stdout\", \"title\": \"Firehose\", \"keywords\": []},\n        ],\n    }\n\ndef run(db, snap):\n    buf = io.StringIO()\n    with redirect_stdout(buf):\n        n = digest.run_once(cfg(snap), db)\n    return n, buf.getvalue()\n\ntmp = tempfile.mktemp(suffix=\".sqlite3\")\ndb = store.connect(tmp)\ntry:\n    a1, body_a1 = run(db, \"snapshot-a\")\n    a2, _ = run(db, \"snapshot-a\")          # immediate re-run, same data\n    b1, body_b1 = run(db, \"snapshot-b\")     # edited + one genuinely-new item\n\n    print(\"run1 snapshot-a sent:\", a1)\n    print(\"run2 snapshot-a sent:\", a2, \"(should be 0)\")\n    print(\"run3 snapshot-b sent:\", b1, \"(should be 2: only the new newsroom item, to ops+everything)\")\n\n    ok = True\n    def check(cond, msg):\n        global ok\n        print((\"PASS\" if cond else \"FAIL\"), \"-\", msg)\n        ok = ok and cond\n\n    check(a1 == 12, \"snapshot-a first run sends 12 (3 ops + 3 energy + 6 firehose)\")\n    check(a2 == 0, \"re-run with identical data sends nothing (the reported bug)\")\n    check(b1 == 2, \"snapshot-b sends only the genuinely-new item\")\n    check(\"Union responds\" in body_b1, \"new newsroom item is delivered\")\n    check(\"Port fee inquiry opened\" not in body_b1, \"edited wire item (guid changed, same link) NOT resent\")\n    check(\"port fee arithmetic\" not in body_b1.lower(), \"edited blogroll item (title changed, same permalink) NOT resent\")\n    check(\"Regulator opens inquiry\" not in body_b1, \"seen newsroom item (utm_campaign rotated) NOT resent\")\n    print(\"\\nRESULT:\", \"ALL PASS\" if ok else \"FAILURES\")\n    sys.exit(0 if ok else 1)\nfinally:\n    db.close()\n    os.remove(tmp)\nPY" action.permission=* action.action=allow action.pattern=*
