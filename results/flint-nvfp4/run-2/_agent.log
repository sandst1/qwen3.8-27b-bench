timestamp=2026-10-22T07:58:29.339Z level=INFO run=00585d0f message=evaluated permission=bash pattern="cat > /tmp/ndtest/probe.py <<'EOF'\nimport sys, tempfile, contextlib, io\nfrom pathlib import Path\nfrom unittest.mock import patch\nimport channels, digest, feeds, store, render\n\nROOT = Path(\"/tmp/ndtest\")\n\ndef config(snapshot=\"a\"):\n    cfg = digest.load_config(ROOT / \"config.example.toml\")\n    for feed in cfg[\"feeds\"]:\n        feed[\"url\"] = str(ROOT / \"fixtures\" / f\"snapshot-{snapshot}\" / f\"{feed['name']}.json\")\n    return cfg\n\norig_digest = render.digest\ndef spy(items, chan_cfg):\n    print(f\"RENDER {chan_cfg['name']}: {len(items)} items\")\n    for i in items: print(\"   -\", i[\"source\"], i[\"raw_id\"], i[\"title\"])\n    return orig_digest(items, chan_cfg)\n\ntmp = tempfile.TemporaryDirectory()\ndb = store.connect(Path(tmp.name)/\"d.sqlite3\")\ncfg = config()\n\nwith patch(\"channels.send\") as send, patch(\"render.digest\", side_effect=spy):\n    try:\n        r = digest.run_once(cfg, db)\n        print(\"run1 sent:\", r)\n    except Exception as e:\n        print(\"run1 raised:\", e)\n\nwith patch(\"channels.send\") as send, patch(\"render.digest\", side_effect=spy):\n    r = digest.run_once(cfg, db)\n    print(\"run2 sent:\", r)\nEOF" action.permission=* action.action=allow action.pattern=*
