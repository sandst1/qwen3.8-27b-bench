[[channels]]
name = "ops"
type = "stdout"
title = "Ops digest"
keywords = ["port", "levy", "fee"]

[[channels]]
name = "energy"
type = "stdout"
title = "Energy digest"
keywords = ["tender", "grid", "offshore"]

[[channels]]
name = "everything"
type = "stdout"
title = "Firehose"
keywords = []
