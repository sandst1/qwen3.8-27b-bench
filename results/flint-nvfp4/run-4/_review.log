diff --git a/README.md b/README.md
index b077513..3e6836f 100644
--- a/README.md
+++ b/README.md
@@ -14,6 +14,19 @@ python3 digest.py --config config.toml --db digest.sqlite3
 
 Requires Python 3.11+ (uses `tomllib`). No third-party dependencies.
 
+## How repeats are avoided
+
+Every run only sends items the archive (`digest.sqlite3`) has not seen before;
+items that were already sent are filtered out before any channel is messaged.
+
+An item is identified by its feed source plus a stable per-item id (the
+provider's entry id, or the item's canonical link when the feed has none), so
+the same item is delivered once — on the cron tick after it first shows up.
+
+Delivery stays best effort: if sending raises, the error propagates and the item
+is not marked as sent, so the next tick retries it. Only items that went out are
+marked as seen.
+
 ## Layout
 
 | File | Purpose |
diff --git a/digest.py b/digest.py
index a1abc33..5b84eb4 100644
--- a/digest.py
+++ b/digest.py
@@ -37,12 +37,12 @@ def run_once(cfg, db, dry_run=False):
         except feeds.FeedError as exc:
             print(f"warn: feed {feed_cfg['name']} failed: {exc}", file=sys.stderr)
             continue
-        store.record_items(db, feed_cfg["name"], items)
-        all_items.extend(items)
+        all_items.extend(store.filter_new(db, feed_cfg["name"], items))
 
     all_items.sort(key=lambda i: i.get("published", ""), reverse=True)
 
     sent = 0
+    marked = set()
     for chan_cfg in cfg["channels"]:
         selected = [i for i in all_items if matches(i, chan_cfg)]
         if not selected:
@@ -54,6 +54,12 @@ def run_once(cfg, db, dry_run=False):
             continue
         channels.send(chan_cfg, body)
         sent += len(selected)
+        for item in selected:
