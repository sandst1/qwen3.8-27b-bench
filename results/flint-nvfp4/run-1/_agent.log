timestamp=2026-10-22T07:41:03.061Z level=INFO run=f3a00df0 message=evaluated permission=bash pattern="cat > /tmp/trace_run2.py <<'EOF'\nimport contextlib, io, sys, tempfile\nfrom pathlib import Path\nfrom unittest.mock import patch\nsys.path.insert(0, \"/private/tmp/notify-digest-agent\")\nimport digest, store, feeds, channels, render\n\nROOT = Path(\"/private/tmp/notify-digest-agent\")\n\ndef config(snapshot=\"snapshot-a\"):\n    cfg = digest.load_config(ROOT / \"config.example.toml\")\n    for feed in cfg[\"feeds\"]:\n        feed[\"url\"] = str(ROOT / \"fixtures\" / snapshot / f\"{feed['name']}.json\")\n    return cfg\n\ntemp = tempfile.TemporaryDirectory()\ndb = store.connect(str(Path(temp.name) / \"d.sqlite3\"))\nreal_fetch = feeds.fetch\ndef fail_wire(feed):\n    if feed[\"name\"] == \"wire\":\n        raise feeds.FeedError(\"offline\")\n    return real_fetch(feed)\n\nsent_bodies = []\ndef fake_send(chan, body):\n    sent_bodies.append((chan[\"name\"], body))\n\nwith patch(\"channels.send\", side_effect=fake_send), patch(\"feeds.fetch\", side_effect=fail_wire), contextlib.redirect_stderr(io.StringIO()):\n    print(\"RUN1:\", digest.run_once(config(), db))\n\nsent_bodies.clear()\nwith patch(\"channels.send\", side_effect=fake_send):\n    print(\"RUN2:\", digest.run_once(config(), db))\n\nfor n, b in sent_bodies:\n    print(f\"--- SENT IN RUN2 TO {n} ---\\n{b}\")\nfor row in db.execute(\"SELECT channel, source, item_key, sent_at FROM deliveries ORDER BY sent_at, channel, source\"):\n    print(\"DELIV:\", dict(row))\ndb.close()\nEOF" action.permission=* action.action=allow action.pattern=*
