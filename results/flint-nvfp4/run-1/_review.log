/opt/homebrew/bin/python3.13 - <<'EOF'
import sys
sys.path.insert(0, ".")
import digest, store, channels
from unittest.mock import patch

cfg = digest.load_config("config.toml")
db = store.connect("digest.sqlite3")

calls = []
def fail_energy(chan_cfg, body):
    calls.append(chan_cfg["name"])
    if chan_cfg["name"] == "energy":
        raise channels.DeliveryError("simulated outage")
    print(f"[sent to {chan_cfg['name']}]")

with patch("channels.send", side_effect=fail_energy):
    try:
        sent = digest.run_once(cfg, db)
        print("run_once returned", sent, "(expected an exception!)")
    except channels.DeliveryError as e:
        print("run_once raised as expected:", e)
        print("channels attempted before crash:", calls)

db.close()

# Re-run: ops must NOT resend, energy+everything must
db = store.connect("digest.sqlite3")
calls2 = []
def record(chan_cfg, body):
    calls2.append((chan_cfg["name"], body.count("* ")))
    print(f"[sent to {chan_cfg['name']}]")

with patch("channels.send", side_effect=record):
    sent2 = digest.run_once(cfg, db)
    print("second run sent:", sent2, "channels:", calls2)
db.close()
EOF
