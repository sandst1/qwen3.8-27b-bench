/opt/homebrew/bin/python3.13 - <<'EOF'
import sys
sys.path.insert(0, ".")
import digest, store, feeds
from unittest.mock import patch

cfg = digest.load_config("config.toml")
db = store.connect("digest.sqlite3")

real_fetch = feeds.fetch
def fail_wire(feed_cfg):
    if feed_cfg["name"] == "wire":
        raise feeds.FeedError("simulated 500")
    return real_fetch(feed_cfg)

with patch("feeds.fetch", side_effect=fail_wire), patch("channels.send") as send:
    sent = digest.run_once(cfg, db)
    print("run with wire down, sent:", sent)  # newsroom(2)+blogroll(2) items across channels, no wire
    print("channels called:", [c.args[0]["name"] for c in send.call_args_list])

with patch("channels.send") as send:
    sent2 = digest.run_once(cfg, db)  # wire now back up
    print("run with wire back up, sent:", sent2)  # should include wire's 2 items now, nothing repeated
    for c in send.call_args_list:
        print(" ->", c.args[0]["name"], "body has", c.args[1].count("* "), "items")
db.close()
EOF
