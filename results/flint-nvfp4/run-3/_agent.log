timestamp=2026-10-22T08:17:46.247Z level=INFO run=83c983b6 message=evaluated permission=bash pattern="cat > /tmp/test_digest.py <<'EOF'\nimport sys, types, os, io, contextlib\nsys.path.insert(0, \"/private/var/folders/p4/n0xz6vp14wq0xc0ktf097vhw0000gn/T/bench-flint-nvfp4-3-h4bafc38/notify-digest\")\nm = types.ModuleType('tomllib'); m.load = lambda f: {}\nsys.modules['tomllib'] = m\nimport digest, store\n\ndef make_cfg(feed_url):\n    return {\n        \"feeds\": [\n            {\"name\": \"newsroom\", \"format\": \"newsroom\", \"url\": f\"file://{feed_url}/newsroom.json\"},\n            {\"name\": \"blogroll\", \"format\": \"blogroll\", \"url\": f\"file://{feed_url}/blogroll.json\"},\n            {\"name\": \"wire\", \"format\": \"generic\", \"url\": f\"file://{feed_url}/wire.json\"},\n        ],\n        \"channels\": [\n            {\"name\": \"ops\", \"type\": \"stdout\", \"title\": \"Ops digest\", \"keywords\": [\"port\", \"levy\", \"fee\"]},\n            {\"name\": \"energy\", \"type\": \"stdout\", \"title\": \"Energy digest\", \"keywords\": [\"tender\", \"grid\", \"offshore\"]},\n            {\"name\": \"everything\", \"type\": \"stdout\", \"title\": \"Firehose\", \"keywords\": []},\n        ],\n    }\n\ndef run(cfg, db, dry=False):\n    buf = io.StringIO()\n    with contextlib.redirect_stdout(buf):\n        sent = digest.run_once(cfg, db, dry_run=dry)\n    out = buf.getvalue()\n    return sent, out\n\ndb = \"/tmp/digest-test.sqlite3\"\nif os.path.exists(db): os.remove(db)\ncfg = make_cfg(\"fixtures/snapshot-a\")\n\ns1, o1 = run(cfg, db)\nprint(\"RUN1 sent:\", s1); print(o1)\ns2, o2 = run(cfg, db)\nprint(\"RUN2 sent:\", s2); print(o2)\ns3, o3 = run(cfg, db, dry=True)\nprint(\"RUN3 (dry) sent:\", s3); print(o3)\n\nconn = store.connect(db)\nprint(\"archive rows:\", store.count_items(conn))\nfor r in conn.execute(\"SELECT source, raw_id, title FROM items\"):\n    print(\"  row:\", tuple(r))\nEOF" action.permission=* action.action=allow action.pattern=*
