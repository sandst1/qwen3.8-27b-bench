timestamp=2026-10-22T08:13:10.714Z level=INFO run=83c983b6 message=evaluated permission=bash pattern="python3 -c \"\nimport sqlite3\nprint(sqlite3.sqlite_version)\nconn = sqlite3.connect(':memory:')\nconn.executescript('''\nCREATE TABLE items (id INTEGER PRIMARY KEY AUTOINCREMENT, source TEXT NOT NULL, raw_id TEXT, title TEXT NOT NULL, link TEXT NOT NULL, summary TEXT, published TEXT, first_seen TEXT NOT NULL DEFAULT (datetime(\\\"now\\\")));\nCREATE INDEX IF NOT EXISTS idx_items_source ON items(source);\nDELETE FROM items WHERE id NOT IN (SELECT MIN(id) FROM items GROUP BY source, COALESCE(raw_id, link));\nCREATE UNIQUE INDEX IF NOT EXISTS idx_items_source_raw ON items(source, COALESCE(raw_id, link));\n''')\nimport sqlite3 as s\ncur = conn.execute(\\\"INSERT OR IGNORE INTO items (source, raw_id, title, link, summary, published) VALUES ('wire','wire-1','T','L','','p')\\\")\nprint('first insert rowcount:', cur.rowcount)\ncur = conn.execute(\\\"INSERT OR IGNORE INTO items (source, raw_id, title, link, summary, published) VALUES ('wire','wire-1','T','L','','p')\\\")\nprint('dup insert rowcount:', cur.rowcount)\ncur = conn.execute(\\\"INSERT OR IGNORE INTO items (source, raw_id, title, link, summary, published) VALUES ('wire',NULL,'T2','L2','','p')\\\")\ncur = conn.execute(\\\"INSERT OR IGNORE INTO items (source, raw_id, title, link, summary, published) VALUES ('wire',NULL,'T3','L3','','p')\\\")\nprint('null-raw_id inserts:', cur.rowcount)\nprint(conn.execute('SELECT COUNT(*) FROM items').fetchone()[0])\n\"" action.permission=* action.action=allow action.pattern=*
