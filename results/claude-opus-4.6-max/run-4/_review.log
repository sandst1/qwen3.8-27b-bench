import sqlite3
# Simulate an existing production db using the ORIGINAL schema/insert logic
# (unconditional insert, no unique constraint) accumulating duplicates over time.
conn = sqlite3.connect("/tmp/prod_sim.sqlite3")
conn.execute("""
CREATE TABLE items (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    source TEXT NOT NULL,
    raw_id TEXT,
    title TEXT NOT NULL,
    link TEXT NOT NULL,
    summary TEXT,
    published TEXT,
    first_seen TEXT NOT NULL DEFAULT (datetime('now'))
)
""")
# Same item fetched on 3 separate cron ticks before the fix was ever deployed
for _ in range(3):
    conn.execute(
        "INSERT INTO items (source, raw_id, title, link, summary, published) VALUES (?,?,?,?,?,?)",
        ("newsroom", "84121", "Regulator opens inquiry into port fees",
         "https://newsroom.example/2026/08/port-fees?utm_source=feed&utm_campaign=w33",
         "x", "2026-08-14")
    )
conn.commit()
conn.close()
print("prod db simulated with duplicate (source, link) rows")
