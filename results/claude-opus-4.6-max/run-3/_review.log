import sqlite3
conn = sqlite3.connect("legacy.sqlite3")
conn.execute("""
CREATE TABLE items (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    source TEXT NOT NULL,
    raw_id TEXT,
    title TEXT NOT NULL,
    link TEXT NOT NULL,
    summary TEXT,
    published TEXT,
    first_seen TEXT NOT NULL DEFAULT (datetime('now'))
)
""")
# simulate old duplicate rows accumulated pre-fix (same source+link inserted every 15 min for weeks)
for _ in range(5):
    conn.execute("INSERT INTO items (source, raw_id, title, link) VALUES ('wire','g1','t','https://wire.example/i/0031')")
conn.commit()
conn.close()
print("legacy db created with duplicate (source, link) rows")
