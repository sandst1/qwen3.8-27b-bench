[0m$ [0mcd /tmp/nd-test && python3 -c "
import digest, store, channels
cfg = digest.load_config('config.toml')
db = store.connect('digest.sqlite3')

orig_send = channels.send
calls = []
def fake_send(chan_cfg, body):
    calls.append(chan_cfg['name'])
    if chan_cfg['name'] == 'everything':
        raise channels.DeliveryError('boom')
    return orig_send(chan_cfg, body)
channels.send = fake_send

# reset db to force resend everything
db.execute('delete from sent')
db.commit()

try:
    digest.run_once(cfg, db)
except Exception as e:
    print('run_once raised:', e)

print('calls made:', calls)
for r in db.execute('select channel, fingerprint from sent'):
    print(dict(zip(['channel','fingerprint'], r)))
"

