timestamp=2026-08-17T04:57:09.991Z level=INFO run=e5034805 message=evaluated permission=bash pattern="python3 - <<'EOF'\nimport json, sqlite3\nfrom pathlib import Path\n\nconn = sqlite3.connect(\"/tmp/old.sqlite3\")\nconn.executescript(\"\"\"\nCREATE TABLE items (\n    id INTEGER PRIMARY KEY AUTOINCREMENT,\n    source TEXT NOT NULL,\n    raw_id TEXT,\n    title TEXT NOT NULL,\n    link TEXT NOT NULL,\n    summary TEXT,\n    published TEXT,\n    first_seen TEXT NOT NULL DEFAULT (datetime('now'))\n);\nCREATE INDEX idx_items_source ON items(source);\n\"\"\")\n\ndef load(fmt, name, path):\n    doc = json.loads(Path(path).read_text())\n    if fmt == \"newsroom\":\n        return [(name, str(r[\"entry_id\"]), r[\"headline\"], r[\"url\"], r.get(\"standfirst\",\"\"), r.get(\"published_at\",\"\")) for r in doc[\"entries\"]]\n    if fmt == \"blogroll\":\n        return [(name, None, r[\"title\"], r[\"permalink\"], r.get(\"excerpt\",\"\"), r.get(\"date\",\"\")) for r in doc[\"posts\"]]\n    return [(name, r.get(\"guid\"), r[\"title\"], r[\"link\"], r.get(\"description\",\"\"), r.get(\"pubDate\",\"\")) for r in doc[\"items\"]]\n\nfeeds = [\n    (\"newsroom\", \"newsroom\", \"fixtures/snapshot-a/newsroom.json\"),\n    (\"blogroll\", \"blogroll\", \"fixtures/snapshot-a/blogroll.json\"),\n    (\"wire\", \"generic\", \"fixtures/snapshot-a/wire.json\"),\n]\n# simulate 4 cron polls: the old code inserted every item every time\nfor tick in range(4):\n    for source, fmt, path in feeds:\n        for row in load(fmt, source, path):\n            conn.execute(\n                \"INSERT INTO items (source, raw_id, title, link, summary, published, first_seen)\"\n                \" VALUES (?,?,?,?,?,?, datetime('now', ?))\",\n                (*row, f\"+{tick} hours\"),\n            )\nconn.commit()\nprint(\"old db rows:\", conn.execute(\"SELECT COUNT(*) FROM items\").fetchone()[0])\nprint(\"distinct stories:\", len({r[0] for r in conn.execute(\"SELECT link FROM items\")}))\nconn.close()\nEOF" action.permission=* action.action=allow action.pattern=*
