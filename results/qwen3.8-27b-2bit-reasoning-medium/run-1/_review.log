=== digest.py ===
     1	#!/usr/bin/env python3
     2	"""notify-digest — poll a few feeds, filter them, send digests to channels.
     3	
     4	Run from cron. See README.md.
     5	
     6	Only items a channel has not already received are sent; the per-channel
     7	record lives in the `sent` table (see store.py).
     8	"""
     9	
    10	import argparse
    11	import sys
    12	import tomllib
    13	from pathlib import Path
    14	
    15	import channels
    16	import feeds
    17	import render
    18	import store
    19	
    20	
    21	def load_config(path):
    22	    with open(path, "rb") as fh:
    23	        return tomllib.load(fh)
    24	
    25	
    26	def matches(item, filt):
    27	    """A channel filter is a list of keywords; empty list means 'everything'."""
    28	    keywords = filt.get("keywords", [])
    29	    if not keywords:
    30	        return True
    31	    haystack = (item["title"] + " " + item.get("summary", "")).lower()
    32	    return any(k.lower() in haystack for k in keywords)
    33	
    34	
    35	def run_once(cfg, db, dry_run=False):
    36	    all_items = []
    37	    for feed_cfg in cfg["feeds"]:
    38	        try:
    39	            items = feeds.fetch(feed_cfg)
    40	        except feeds.FeedError as exc:
    41	            print(f"warn: feed {feed_cfg['name']} failed: {exc}", file=sys.stderr)
    42	            continue
    43	        store.record_items(db, feed_cfg["name"], items)
    44	        all_items.extend(items)
    45	
    46	    all_items.sort(key=lambda i: i.get("published", ""), reverse=True)
    47	
    48	    sent = 0
    49	    for chan_cfg in cfg["channels"]:
    50	        # Per-channel dedup: an item may match several channels and should
    51	        # reach each of them exactly once, but never twice.
    52	        seen = store.sent_keys(db, chan_cfg["name"])
    53	        selected = [
    54	            i for i in all_items
    55	            if matches(i, chan_cfg) and store.item_key(i) not in seen
    56	        ]
    57	        if not selected:
    58	            continue
    59	        body = render.digest(selected, chan_cfg)
    60	        if dry_run:
    61	            print(f"--- would send to {chan_cfg['name']} ---")
    62	            print(body)
    63	            continue
    64	        channels.send(chan_cfg, body)
    65	        # Mark only after a successful send, so a failed channel is retried
    66	        # on the next tick instead of silently dropping the items.
    67	        store.mark_sent(db, chan_cfg["name"], selected)
    68	        sent += len(selected)
    69	
    70	    return sent
    71	
    72	
    73	def main(argv=None):
    74	    ap = argparse.ArgumentParser(prog="digest")
    75	    ap.add_argument("--config", default="config.toml")
    76	    ap.add_argument("--db", default="digest.sqlite3")
    77	    ap.add_argument("--dry-run", action="store_true")
    78	    args = ap.parse_args(argv)
    79	
    80	    cfg = load_config(args.config)
    81	    db = store.connect(args.db)
    82	    try:
    83	        sent = run_once(cfg, db, dry_run=args.dry_run)
    84	        print(f"sent {sent} items")
    85	    finally:
    86	        db.close()
    87	    return 0
    88	
    89	
    90	if __name__ == "__main__":
    91	    raise SystemExit(main())

=== store.py ===
     1	"""SQLite persistence.
     2	
     3	Two tables:
     4	
     5	* `items` -- an observation log: one row per item per fetch. Kept so we can
     6	  answer "did this ever come through?" when someone asks. Deliberately not
     7	  deduplicated; the dedup record is `sent`.
     8	* `sent`  -- one row per (source, link, channel) for the moment an item was
     9	  successfully delivered to that channel. digest.py only sends items that
    10	  are not here yet for that channel, which is what stops the 15-minute cron
    11	  from re-sending the same items every tick.
    12	
    13	Why does dedup key on (source, link) instead of raw_id? See `item_key`.
    14	"""
    15	
    16	import sqlite3
    17	from urllib.parse import urlsplit, urlunsplit
    18	
    19	SCHEMA = """
    20	CREATE TABLE IF NOT EXISTS items (
    21	    id          INTEGER PRIMARY KEY AUTOINCREMENT,
    22	    source      TEXT NOT NULL,
    23	    raw_id      TEXT,
    24	    title       TEXT NOT NULL,
    25	    link        TEXT NOT NULL,
    26	    summary     TEXT,
    27	    published   TEXT,
    28	    first_seen  TEXT NOT NULL DEFAULT (datetime('now'))
    29	);
    30	
    31	CREATE INDEX IF NOT EXISTS idx_items_source ON items(source);
    32	
    33	CREATE TABLE IF NOT EXISTS sent (
    34	    source     TEXT NOT NULL,
    35	    link       TEXT NOT NULL,
    36	    channel    TEXT NOT NULL,
    37	    first_sent TEXT NOT NULL DEFAULT (datetime('now')),
    38	    PRIMARY KEY (source, link, channel)
    39	);
    40	"""
    41	
    42	
    43	def item_key(item):
    44	    """The (source, link) pair that identifies an item across runs.
    45	
    46	    Deliberately NOT raw_id: blogroll has no identifier at all, and the wire
    47	    feed regenerates its guid whenever an item is edited (typos, retitles),
    48	    which would re-send edited items. Deliberately NOT the raw link either:
    49	    newsroom appends rotating utm_* tracking params to the same article, so
    50	    the raw link changes week to week. Stripping the query string and
    51	    fragment leaves a permalink that is stable for all three providers.
    52	    """
    53	    parts = urlsplit(item["link"])
    54	    return item["source"], urlunsplit((parts.scheme, parts.netloc, parts.path, "", ""))
    55	
    56	
    57	def connect(path):
    58	    conn = sqlite3.connect(path)
    59	    conn.row_factory = sqlite3.Row
    60	    conn.executescript(SCHEMA)
    61	    conn.commit()
    62	    return conn
    63	
    64	
    65	def record_items(conn, source, items):
    66	    conn.executemany(
    67	        "INSERT INTO items (source, raw_id, title, link, summary, published)"
    68	        " VALUES (?, ?, ?, ?, ?, ?)",
    69	        [
    70	            (source, i["raw_id"], i["title"], i["link"], i.get("summary"), i.get("published"))
    71	            for i in items
    72	        ],
    73	    )
    74	    conn.commit()
    75	
    76	
    77	def sent_keys(conn, channel):
    78	    """Set of item keys already delivered to `channel`."""
    79	    return {
    80	        (row["source"], row["link"])
    81	        for row in conn.execute("SELECT source, link FROM sent WHERE channel = ?", (channel,))
    82	    }
    83	
    84	
    85	def mark_sent(conn, channel, items):
    86	    """Record that `items` were delivered to `channel`.
    87	
    88	    Call this only after a successful send: if delivery fails, the items
    89	    stay unmarked and get retried on the next cron tick.
    90	    """
    91	    conn.executemany(
    92	        "INSERT OR IGNORE INTO sent (source, link, channel) VALUES (?, ?, ?)",
    93	        [(*item_key(i), channel) for i in items],
    94	    )
    95	    conn.commit()
    96	
    97	
    98	def count_items(conn):
    99	    return conn.execute("SELECT COUNT(*) AS n FROM items").fetchone()["n"]

=== README.md ===
     1	# notify-digest
     2	
     3	A small cron job that pulls a handful of feeds, filters the items per channel,
     4	and sends each channel a digest.
     5	
     6	## Running
     7	
     8	```sh
     9	cp config.example.toml config.toml
    10	python3 digest.py --config config.toml --db digest.sqlite3
    11	```
    12	
    13	`--dry-run` prints what would be sent instead of sending it.
    14	
    15	Requires Python 3.11+ (uses `tomllib`). No third-party dependencies.
    16	
    17	## Layout
    18	
    19	| File | Purpose |
    20	| --- | --- |
    21	| `digest.py` | CLI entry point, the per-run loop |
    22	| `feeds.py` | Fetching and normalising the three feed formats |
    23	| `store.py` | SQLite: observation archive + per-channel dedup record |
    24	| `render.py` | Digest text |
    25	| `channels.py` | Delivery (stdout, webhook) |
    26	
    27	The `fixtures/` directory holds two snapshots of the feeds taken at different
    28	times, so you can work on this without network access. Point the config at
    29	`snapshot-a` or `snapshot-b`.
    30	
    31	## Deduplication
    32	
    33	Feeds keep returning recent items, so every run only sends items a channel
    34	has not already received. The record is the `sent` table in the SQLite DB,
    35	keyed per channel: an item that matches several channels reaches each of
    36	them exactly once.
    37	
    38	The identity of an item is `(source, link)` with the query string and
    39	fragment stripped off the link — see `store.item_key()`. This is a
    40	deliberate choice, because none of the per-feed identifiers are reliable on
    41	their own:
    42	
    43	| Feed | Problem with its own identifier |
    44	| --- | --- |
    45	| `newsroom` | `entry_id` is stable, but the URL gains rotating `utm_*` tracking params each week, so the raw link changes |
    46	| `blogroll` | has no identifier at all; the permalink is the only stable field |
    47	| `wire` | the `guid` is regenerated whenever an item is edited, so keying on it would re-send edited items |
    48	
    49	The stripped permalink is stable for all three, and does not change when an
    50	item is edited in place.
    51	
    52	If a delivery fails, the items are not marked sent and are retried on the
    53	next tick (consistent with the best-effort delivery in `channels.py`).
    54	
    55	## Deployment
    56	
    57	Runs from cron on the utility box:
    58	
    59	```
    60	*/15 * * * * cd /srv/notify-digest && python3 digest.py >> /var/log/digest.log 2>&1
    61	```
