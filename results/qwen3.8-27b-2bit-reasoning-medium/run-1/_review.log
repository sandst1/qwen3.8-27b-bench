=== digest.py ===
     1	#!/usr/bin/env python3
     2	"""notify-digest — poll a few feeds, filter them, send digests to channels.
     3	
     4	Run from cron. See README.md.
     5	"""
     6	
     7	import argparse
     8	import sys
     9	import tomllib
    10	from pathlib import Path
    11	
    12	import channels
    13	import feeds
    14	import render
    15	import store
    16	
    17	
    18	def load_config(path):
    19	    with open(path, "rb") as fh:
    20	        return tomllib.load(fh)
    21	
    22	
    23	def matches(item, filt):
    24	    """A channel filter is a list of keywords; empty list means 'everything'."""
    25	    keywords = filt.get("keywords", [])
    26	    if not keywords:
    27	        return True
    28	    haystack = (item["title"] + " " + item.get("summary", "")).lower()
    29	    return any(k.lower() in haystack for k in keywords)
    30	
    31	
    32	def run_once(cfg, db, dry_run=False):
    33	    all_items = []
    34	    for feed_cfg in cfg["feeds"]:
    35	        try:
    36	            items = feeds.fetch(feed_cfg)
    37	        except feeds.FeedError as exc:
    38	            print(f"warn: feed {feed_cfg['name']} failed: {exc}", file=sys.stderr)
    39	            continue
    40	        store.record_items(db, feed_cfg["name"], items)
    41	        all_items.extend(items)
    42	
    43	    all_items.sort(key=lambda i: i.get("published", ""), reverse=True)
    44	
    45	    sent = 0
    46	    for chan_cfg in cfg["channels"]:
    47	        selected = [i for i in all_items if matches(i, chan_cfg)]
    48	        if not selected:
    49	            continue
    50	        body = render.digest(selected, chan_cfg)
    51	        if dry_run:
    52	            print(f"--- would send to {chan_cfg['name']} ---")
    53	            print(body)
    54	            continue
    55	        channels.send(chan_cfg, body)
    56	        sent += len(selected)
    57	
    58	    return sent
    59	
    60	
    61	def main(argv=None):
    62	    ap = argparse.ArgumentParser(prog="digest")
    63	    ap.add_argument("--config", default="config.toml")
    64	    ap.add_argument("--db", default="digest.sqlite3")
    65	    ap.add_argument("--dry-run", action="store_true")
    66	    args = ap.parse_args(argv)
    67	
    68	    cfg = load_config(args.config)
    69	    db = store.connect(args.db)
    70	    try:
    71	        sent = run_once(cfg, db, dry_run=args.dry_run)
    72	        print(f"sent {sent} items")
    73	    finally:
    74	        db.close()
    75	    return 0
    76	
    77	
    78	if __name__ == "__main__":
    79	    raise SystemExit(main())

=== feeds.py ===
     1	"""Feed loading.
     2	
     3	Feeds are JSON documents. Remote feeds are fetched over HTTP; local ones
     4	(used in development and in the fixtures/ directory) are read from disk.
     5	
     6	The three providers we currently pull from do not agree on much, so this
     7	module normalises them into a common item shape:
     8	
     9	    {"title": str, "link": str, "summary": str, "published": str,
    10	     "source": str, "raw_id": str | None}
    11	"""
    12	
    13	import json
    14	import urllib.error
    15	import urllib.request
    16	from pathlib import Path
    17	
    18	
    19	class FeedError(Exception):
    20	    pass
    21	
    22	
    23	def _load(feed_cfg):
    24	    url = feed_cfg["url"]
    25	    if url.startswith("file://") or not url.startswith("http"):
    26	        path = Path(url.replace("file://", ""))
    27	        try:
    28	            return json.loads(path.read_text())
    29	        except (OSError, json.JSONDecodeError) as exc:
    30	            raise FeedError(str(exc)) from exc
    31	    try:
    32	        with urllib.request.urlopen(url, timeout=15) as resp:
    33	            return json.loads(resp.read().decode())
    34	    except (urllib.error.URLError, json.JSONDecodeError, TimeoutError) as exc:
    35	        raise FeedError(str(exc)) from exc
    36	
    37	
    38	def fetch(feed_cfg):
    39	    doc = _load(feed_cfg)
    40	    name = feed_cfg["name"]
    41	    fmt = feed_cfg.get("format", "generic")
    42	
    43	    if fmt == "newsroom":
    44	        rows = doc.get("entries", [])
    45	        return [
    46	            {
    47	                "title": r["headline"],
    48	                "link": r["url"],
    49	                "summary": r.get("standfirst", ""),
    50	                "published": r.get("published_at", ""),
    51	                "source": name,
    52	                "raw_id": str(r["entry_id"]),
    53	            }
    54	            for r in rows
    55	        ]
    56	
    57	    if fmt == "blogroll":
    58	        # No stable identifier of any kind in this one.
    59	        return [
    60	            {
    61	                "title": r["title"],
    62	                "link": r["permalink"],
    63	                "summary": r.get("excerpt", ""),
    64	                "published": r.get("date", ""),
    65	                "source": name,
    66	                "raw_id": None,
    67	            }
    68	            for r in doc.get("posts", [])
    69	        ]
    70	
    71	    # "generic": has a guid, but the provider regenerates it whenever an
    72	    # item is edited (typos, added tags, retitles).
    73	    return [
    74	        {
    75	            "title": r["title"],
    76	            "link": r["link"],
    77	            "summary": r.get("description", ""),
    78	            "published": r.get("pubDate", ""),
    79	            "source": name,
    80	            "raw_id": r.get("guid"),
    81	        }
    82	        for r in doc.get("items", [])
    83	    ]

=== channels.py ===
     1	"""Delivery channels.
     2	
     3	`webhook` posts the digest body as JSON. `stdout` just prints it, which is
     4	what we use locally. Delivery is best effort: if a channel is down we let the
     5	exception propagate and cron will pick us up again on the next tick.
     6	"""
     7	
     8	import json
     9	import urllib.error
    10	import urllib.request
    11	
    12	
    13	class DeliveryError(Exception):
    14	    pass
    15	
    16	
    17	def send(chan_cfg, body):
    18	    kind = chan_cfg.get("type", "stdout")
    19	
    20	    if kind == "stdout":
    21	        print(f"=== {chan_cfg['name']} ===")
    22	        print(body)
    23	        return
    24	
    25	    if kind == "webhook":
    26	        payload = json.dumps({"text": body}).encode()
    27	        req = urllib.request.Request(
    28	            chan_cfg["url"],
    29	            data=payload,
    30	            headers={"Content-Type": "application/json"},
    31	        )
    32	        try:
    33	            with urllib.request.urlopen(req, timeout=10) as resp:
    34	                if resp.status >= 300:
    35	                    raise DeliveryError(f"{chan_cfg['name']}: HTTP {resp.status}")
    36	        except urllib.error.URLError as exc:
    37	            raise DeliveryError(f"{chan_cfg['name']}: {exc}") from exc
    38	        return
    39	
    40	    raise DeliveryError(f"unknown channel type {kind!r}")

=== store.py ===
     1	"""SQLite persistence.
     2	
     3	The `items` table is an archive of everything we have ever seen, mostly so
     4	that we can answer "did this ever come through?" when someone asks. Nothing
     5	reads it at the moment.
     6	"""
     7	
     8	import sqlite3
     9	
    10	SCHEMA = """
    11	CREATE TABLE IF NOT EXISTS items (
    12	    id          INTEGER PRIMARY KEY AUTOINCREMENT,
    13	    source      TEXT NOT NULL,
    14	    raw_id      TEXT,
    15	    title       TEXT NOT NULL,
    16	    link        TEXT NOT NULL,
    17	    summary     TEXT,
    18	    published   TEXT,
    19	    first_seen  TEXT NOT NULL DEFAULT (datetime('now'))
    20	);
    21	
    22	CREATE INDEX IF NOT EXISTS idx_items_source ON items(source);
    23	"""
    24	
    25	
    26	def connect(path):
    27	    conn = sqlite3.connect(path)
    28	    conn.row_factory = sqlite3.Row
    29	    conn.executescript(SCHEMA)
    30	    conn.commit()
    31	    return conn
    32	
    33	
    34	def record_items(conn, source, items):
    35	    conn.executemany(
    36	        "INSERT INTO items (source, raw_id, title, link, summary, published)"
    37	        " VALUES (?, ?, ?, ?, ?, ?)",
    38	        [
    39	            (source, i["raw_id"], i["title"], i["link"], i.get("summary"), i.get("published"))
    40	            for i in items
    41	        ],
    42	    )
    43	    conn.commit()
    44	
    45	
    46	def count_items(conn):
    47	    return conn.execute("SELECT COUNT(*) AS n FROM items").fetchone()["n"]

=== render.py ===
     1	"""Digest rendering."""
     2	
     3	import textwrap
     4	
     5	
     6	def digest(items, chan_cfg):
     7	    lines = [f"{chan_cfg.get('title', 'Digest')} — {len(items)} item(s)", ""]
     8	    for item in items:
     9	        lines.append(f"* {item['title']}  [{item['source']}]")
    10	        summary = (item.get("summary") or "").strip()
    11	        if summary:
    12	            lines.extend(textwrap.wrap(summary, width=76, initial_indent="  ", subsequent_indent="  "))
    13	        lines.append(f"  {item['link']}")
    14	        lines.append("")
    15	    return "\n".join(lines)

=== README.md ===
     1	# notify-digest
     2	
     3	A small cron job that pulls a handful of feeds, filters the items per channel,
     4	and sends each channel a digest.
     5	
     6	## Running
     7	
     8	```sh
     9	cp config.example.toml config.toml
    10	python3 digest.py --config config.toml --db digest.sqlite3
    11	```
    12	
    13	`--dry-run` prints what would be sent instead of sending it.
    14	
    15	Requires Python 3.11+ (uses `tomllib`). No third-party dependencies.
    16	
    17	## Layout
    18	
    19	| File | Purpose |
    20	| --- | --- |
    21	| `digest.py` | CLI entry point, the per-run loop |
    22	| `feeds.py` | Fetching and normalising the three feed formats |
    23	| `store.py` | SQLite archive of everything seen |
    24	| `render.py` | Digest text |
    25	| `channels.py` | Delivery (stdout, webhook) |
    26	
    27	The `fixtures/` directory holds two snapshots of the feeds taken at different
    28	times, so you can work on this without network access. Point the config at
    29	`snapshot-a` or `snapshot-b`.
    30	
    31	## Deployment
    32	
    33	Runs from cron on the utility box:
    34	
    35	```
    36	*/15 * * * * cd /srv/notify-digest && python3 digest.py >> /var/log/digest.log 2>&1
    37	```

