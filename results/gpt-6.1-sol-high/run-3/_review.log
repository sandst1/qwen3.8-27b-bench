python3 - << 'EOF'
import sys
sys.path.insert(0, '.')
import digest, store, channels
from unittest.mock import patch

cfg = digest.load_config('config.toml')
db = store.connect('digest.sqlite3')

def fail_ops(chan_cfg, body):
    if chan_cfg["name"] == "ops":
        raise channels.DeliveryError("ops webhook permanently down")
    print(f"DELIVERED to {chan_cfg['name']}: {len(body.splitlines())} lines")

# Simulate 3 consecutive cron ticks, all with ops broken.
for tick in range(1, 4):
    print(f"--- tick {tick} ---")
    with patch("channels.send", side_effect=fail_ops):
        try:
            digest.run_once(cfg, db)
        except channels.DeliveryError as e:
            print("crashed:", e)
db.close()
EOF

