24:def item_identity(item, feed_cfg):
25:    """Stable within a source; edits are not new notifications.
26:
27:    Only newsroom promises stable IDs. Other providers need a permalink;
28:    discard known tracking parameters, but keep article-identifying queries.
29:    Prefixes keep ID and URL identities in separate namespaces.
30:    """
31:    if feed_cfg.get("format", "generic") == "newsroom" and item.get("raw_id") is not None:
32:        return "id:" + str(item["raw_id"])
33:    url = urlsplit(item["link"])
34:    query = sorted(
35:        (key, value)
36:        for key, value in parse_qsl(url.query, keep_blank_values=True)
37:        if not key.lower().startswith("utm_") and key.lower() not in {"fbclid", "gclid"}
38:    )
39:    return "url:" + urlunsplit(
40:        (url.scheme.lower(), url.netloc.lower(), url.path, urlencode(query), "")
41:    )
