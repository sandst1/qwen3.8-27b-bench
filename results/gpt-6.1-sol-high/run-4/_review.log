1:"""SQLite persistence.
2:
3:The `items` table is an observation archive, not proof of delivery.
4:`deliveries` records successful sends per channel and stable source identity.
5:Keep the two separate: fetching or previewing an item must not suppress it.
6:"""
7:
8:import sqlite3
9:
10:SCHEMA = """
11:CREATE TABLE IF NOT EXISTS items (
12:    id          INTEGER PRIMARY KEY AUTOINCREMENT,
13:    source      TEXT NOT NULL,
14:    raw_id      TEXT,
15:    title       TEXT NOT NULL,
16:    link        TEXT NOT NULL,
17:    summary     TEXT,
18:    published   TEXT,
19:    first_seen  TEXT NOT NULL DEFAULT (datetime('now'))
20:);
21:
22:CREATE INDEX IF NOT EXISTS idx_items_source ON items(source);
23:
24:CREATE TABLE IF NOT EXISTS deliveries (
25:    channel     TEXT NOT NULL,
26:    source      TEXT NOT NULL,
27:    identity    TEXT NOT NULL,
28:    sent_at     TEXT NOT NULL DEFAULT (datetime('now')),
29:    PRIMARY KEY (channel, source, identity)
30:);
31:"""
32:
33:
34:def connect(path):
35:    conn = sqlite3.connect(path)
36:    conn.row_factory = sqlite3.Row
37:    conn.executescript(SCHEMA)
38:    conn.commit()
39:    return conn
40:
41:
42:def record_items(conn, source, items):
43:    conn.executemany(
44:        "INSERT INTO items (source, raw_id, title, link, summary, published)"
45:        " VALUES (?, ?, ?, ?, ?, ?)",
46:        [
47:            (source, i["raw_id"], i["title"], i["link"], i.get("summary"), i.get("published"))
48:            for i in items
49:        ],
50:    )
51:    conn.commit()
52:
53:
54:def count_items(conn):
55:    return conn.execute("SELECT COUNT(*) AS n FROM items").fetchone()["n"]
56:
57:
58:def pending_items(conn, channel, items):
59:    """Call under BEGIN IMMEDIATE, held through sending and recording receipts."""
60:    return [
61:        item for item in items
62:        if conn.execute(
63:            "SELECT 1 FROM deliveries WHERE channel = ? AND source = ? AND identity = ?",
64:            (channel, item["source"], item["identity"]),
65:        ).fetchone() is None
66:    ]
67:
68:
69:def record_deliveries(conn, channel, items):
70:    # The caller commits after send succeeds. Never commit inside this helper.
71:    conn.executemany(
72:        "INSERT INTO deliveries (channel, source, identity) VALUES (?, ?, ?)",
73:        [(channel, item["source"], item["identity"]) for item in items],
74:    )
