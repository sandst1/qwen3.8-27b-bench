import digest, store, channels

cfg = digest.load_config("config.toml")
db = store.connect("digest2.sqlite3")

orig_send = channels.send
calls = []
def flaky_send(chan_cfg, body):
    calls.append(chan_cfg["name"])
    if chan_cfg["name"] == "energy":
        raise channels.DeliveryError("simulated failure")
    return orig_send(chan_cfg, body)

channels.send = flaky_send
try:
    sent = digest.run_once(cfg, db)
    print("sent", sent)
except channels.DeliveryError as e:
    print("failed as expected:", e)
print("calls so far:", calls)

# check what's in deliveries table
rows = db.execute("SELECT channel, source, identity FROM deliveries ORDER BY channel").fetchall()
for r in rows:
    print(dict(r))
db.close()
EOF

