31:def run_once(cfg, db, dry_run=False):
32:    unique_items = {}
33:    for feed_cfg in cfg["feeds"]:
34:        try:
35:            items = feeds.fetch(feed_cfg)
36:        except feeds.FeedError as exc:
37:            print(f"warn: feed {feed_cfg['name']} failed: {exc}", file=sys.stderr)
38:            continue
39:        store.record_items(db, feed_cfg["name"], items)
40:        for item in items:
41:            item["identity"] = feeds.item_identity(item, feed_cfg)
42:            unique_items.setdefault((item["source"], item["identity"]), item)
43:
44:    all_items = list(unique_items.values())
45:    all_items.sort(key=lambda i: i.get("published", ""), reverse=True)
46:
47:    sent = 0
48:    for chan_cfg in cfg["channels"]:
49:        # Serialize selection + send + receipt, including overlapping cron runs.
50:        # Each channel commits independently so a later failure cannot erase
51:        # successful earlier deliveries. A send/commit crash can still repeat.
52:        with db:
53:            db.execute("BEGIN IMMEDIATE")
54:            selected = store.pending_items(
55:                db, chan_cfg["name"], [i for i in all_items if matches(i, chan_cfg)]
56:            )
57:            if not selected:
58:                continue
59:            body = render.digest(selected, chan_cfg)
60:            if dry_run:
61:                print(f"--- would send to {chan_cfg['name']} ---")
62:                print(body)
63:                continue
64:            channels.send(chan_cfg, body)
65:            store.record_deliveries(db, chan_cfg["name"], selected)
66:            sent += len(selected)
67:
68:    return sent
