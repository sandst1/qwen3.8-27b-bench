+def sent_keys(conn, channel):
+    """Item keys already delivered to `channel`, so digest.py can skip them."""
+    rows = conn.execute("SELECT item_key FROM sent WHERE channel = ?", (channel,)).fetchall()
+    return {r["item_key"] for r in rows}
+
