print("match a\\x00yyyy ?", conn.execute("SELECT COUNT(*) FROM t WHERE k=?", ("a\x00yyyy",)).fetchone())
print("match a\\x00zzzz ?", conn.execute("SELECT COUNT(*) FROM t WHERE k=?", ("a\x00zzzz",)).fetchone())
