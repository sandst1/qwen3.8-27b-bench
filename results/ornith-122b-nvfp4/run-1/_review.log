python3 - <<'EOF'
import sys
sys.path.insert(0, '.')
import store, feeds, digest, channels

db = store.connect('digest.sqlite3')
cfg = digest.load_config('config.toml')

# monkeypatch channels.send to fail for "energy" channel
orig_send = channels.send
def flaky_send(chan_cfg, body):
    if chan_cfg['name'] == 'energy':
        raise channels.DeliveryError("simulated failure")
    return orig_send(chan_cfg, body)
channels.send = flaky_send

try:
    sent = digest.run_once(cfg, db)
    print("sent", sent)
except channels.DeliveryError as e:
    print("crashed as expected:", e)

print("sent_keys for ops:", store.sent_keys(db, 'ops'))
print("sent_keys for energy:", store.sent_keys(db, 'energy'))
db.close()
EOF

