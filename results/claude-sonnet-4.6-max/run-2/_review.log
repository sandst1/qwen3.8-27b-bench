import digest, store, channels
cfg = digest.load_config('config.example.toml')
db = store.connect('digest2.sqlite3')

# monkeypatch channels.send to fail for the second channel only
orig_send = channels.send
calls = []
def flaky_send(chan_cfg, body):
    calls.append(chan_cfg['name'])
    if chan_cfg['name'] == 'energy':
        raise channels.DeliveryError('simulated webhook outage')
    return orig_send(chan_cfg, body)
channels.send = flaky_send

try:
    sent = digest.run_once(cfg, db, dry_run=False)
    print('sent', sent)
except channels.DeliveryError as e:
    print('run_once raised:', e)
print('channels attempted before crash:', calls)
print('archive count after crash:', store.count_items(db))
db.close()
"

