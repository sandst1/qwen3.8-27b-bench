     1	"""SQLite persistence.
     2	
     3	The `items` table is an archive of everything we have ever sent. It doubles
     4	as the ledger that tells a fresh run which items are new and which are repeats.
     5	"""
     6	
     7	import sqlite3
     8	
     9	SCHEMA = """
    10	CREATE TABLE IF NOT EXISTS items (
    11	    id          INTEGER PRIMARY KEY AUTOINCREMENT,
    12	    source      TEXT NOT NULL,
    13	    raw_id      TEXT,
    14	    title       TEXT NOT NULL,
    15	    link        TEXT NOT NULL,
    16	    summary     TEXT,
    17	    published   TEXT,
    18	    first_seen  TEXT NOT NULL DEFAULT (datetime('now')),
    19	    dedupe_key  TEXT NOT NULL DEFAULT ''
    20	);
    21	
    22	CREATE INDEX IF NOT EXISTS idx_items_source ON items(source);
    23	"""
    24	
    25	
    26	def connect(path):
    27	    conn = sqlite3.connect(path)
    28	    conn.row_factory = sqlite3.Row
    29	    conn.executescript(SCHEMA)
    30	    cols = {row[1] for row in conn.execute("PRAGMA table_info(items)")}
    31	    if "dedupe_key" not in cols:
    32	        # Databases created before dedupe_key existed get it added on the fly;
    33	        # backfill from the raw identifiers we used before.
    34	        conn.execute("ALTER TABLE items ADD COLUMN dedupe_key TEXT NOT NULL DEFAULT ''")
    35	        conn.execute(
    36	            "UPDATE items SET dedupe_key = COALESCE(raw_id, link) WHERE dedupe_key = ''"
    37	        )
    38	    conn.commit()
    39	    return conn
    40	
    41	
    42	def is_sent(conn, source, dedupe_key):
    43	    """True if we have already sent an item from this source with this key.
    44	
    45	    Items are identified by (source, dedupe_key); that key is the stable
    46	    per-item identity the feed providers expose (entry id, permalink, or —
    47	    for providers that only mint versioned guids — the item URL).
    48	    """
    49	    row = conn.execute(
    50	        "SELECT 1 FROM items WHERE source = ? AND dedupe_key = ? LIMIT 1",
    51	        (source, dedupe_key),
    52	    ).fetchone()
    53	    return row is not None
    54	
    55	
    56	def mark_sent(conn, source, items):
    57	    """Archive items as sent, skipping anything we have already archived.
    58	
    59	    Idempotent per (source, dedupe_key), so calling it twice is harmless. Returns
    60	    the items that were genuinely new.
    61	    """
    62	    known = {
    63	        row[0]
    64	        for row in conn.execute("SELECT dedupe_key FROM items WHERE source = ?", (source,))
    65	    }
    66	    fresh = [i for i in items if i["dedupe_key"] not in known]
    67	    conn.executemany(
    68	        "INSERT INTO items (source, raw_id, title, link, summary, published, dedupe_key)"
    69	        " VALUES (?, ?, ?, ?, ?, ?, ?)",
    70	        [
    71	            (
    72	                source,
    73	                i["raw_id"],
    74	                i["title"],
    75	                i["link"],
    76	                i.get("summary"),
    77	                i.get("published"),
    78	                i["dedupe_key"],
    79	            )
    80	            for i in fresh
    81	        ],
    82	    )
    83	    conn.commit()
    84	    return fresh
    85	
    86	
    87	def count_items(conn):
    88	    return conn.execute("SELECT COUNT(*) AS n FROM items").fetchone()["n"]
