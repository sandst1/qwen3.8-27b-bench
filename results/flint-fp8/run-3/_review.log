1	"""Feed loading.
     2	
     3	Feeds are JSON documents. Remote feeds are fetched over HTTP; local ones
     4	(used in development and in the fixtures/ directory) are read from disk.
     5	
     6	The three providers we currently pull from do not agree on much, so this
     7	module normalises them into a common item shape:
     8	
     9	    {"title": str, "link": str, "summary": str, "published": str,
    10	     "source": str, "raw_id": str | None, "dedupe_key": str}
    11	
    12	`dedupe_key` is the stable identity an item keeps for its whole life:
    13	entry ids, permalinks, or — for providers that only mint versioned
    14	guids — the item URL. It is what we use to recognise repeats.
    15	"""
    16	
    17	import json
    18	import urllib.error
    19	import urllib.request
    20	from pathlib import Path
    21	
    22	
    23	class FeedError(Exception):
    24	    pass
    25	
    26	
    27	def _load(feed_cfg):
    28	    url = feed_cfg["url"]
    29	    if url.startswith("file://") or not url.startswith("http"):
    30	        path = Path(url.replace("file://", ""))
    31	        try:
    32	            return json.loads(path.read_text())
    33	        except (OSError, json.JSONDecodeError) as exc:
    34	            raise FeedError(str(exc)) from exc
    35	    try:
    36	        with urllib.request.urlopen(url, timeout=15) as resp:
    37	            return json.loads(resp.read().decode())
    38	    except (urllib.error.URLError, json.JSONDecodeError, TimeoutError) as exc:
    39	        raise FeedError(str(exc)) from exc
    40	
    41	
    42	def fetch(feed_cfg):
    43	    doc = _load(feed_cfg)
    44	    name = feed_cfg["name"]
    45	    fmt = feed_cfg.get("format", "generic")
    46	
    47	    if fmt == "newsroom":
    48	        rows = doc.get("entries", [])
    49	        return [
    50	            {
    51	                "title": r["headline"],
    52	                "link": r["url"],
    53	                "summary": r.get("standfirst", ""),
    54	                "published": r.get("published_at", ""),
    55	                "source": name,
    56	                "raw_id": str(r["entry_id"]),
    57	                "dedupe_key": str(r["entry_id"]),
    58	            }
    59	            for r in rows
    60	        ]
    61	
    62	    if fmt == "blogroll":
    63	        # No stable identifier of any kind in this one.
    64	        return [
    65	            {
    66	                "title": r["title"],
    67	                "link": r["permalink"],
    68	                "summary": r.get("excerpt", ""),
    69	                "published": r.get("date", ""),
    70	                "source": name,
    71	                "raw_id": None,
    72	                "dedupe_key": r["permalink"],
    73	            }
    74	            for r in doc.get("posts", [])
    75	        ]
    76	
    77	    # "generic": has a guid, but the provider regenerates it whenever an
    78	    # item is edited (typos, added tags, retitles).
    79	    return [
    80	        {
    81	            "title": r["title"],
    82	            "link": r["link"],
    83	            "summary": r.get("description", ""),
    84	            "published": r.get("pubDate", ""),
    85	            "source": name,
    86	            "raw_id": r.get("guid"),
    87	            "dedupe_key": r["link"],
    88	        }
    89	        for r in doc.get("items", [])
    90	    ]
