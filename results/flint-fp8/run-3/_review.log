1	#!/usr/bin/env python3
     2	"""notify-digest — poll a few feeds, filter them, send digests to channels.
     3	
     4	Run from cron. See README.md.
     5	"""
     6	
     7	import argparse
     8	import sys
     9	import tomllib
    10	from pathlib import Path
    11	
    12	import channels
    13	import feeds
    14	import render
    15	import store
    16	
    17	
    18	def load_config(path):
    19	    with open(path, "rb") as fh:
    20	        return tomllib.load(fh)
    21	
    22	
    23	def matches(item, filt):
    24	    """A channel filter is a list of keywords; empty list means 'everything'."""
    25	    keywords = filt.get("keywords", [])
    26	    if not keywords:
    27	        return True
    28	    haystack = (item["title"] + " " + item.get("summary", "")).lower()
    29	    return any(k.lower() in haystack for k in keywords)
    30	
    31	
    32	def run_once(cfg, db, dry_run=False):
    33	    fresh = []
    34	    for feed_cfg in cfg["feeds"]:
    35	        try:
    36	            items = feeds.fetch(feed_cfg)
    37	        except feeds.FeedError as exc:
    38	            print(f"warn: feed {feed_cfg['name']} failed: {exc}", file=sys.stderr)
    39	            continue
    40	        fresh.extend(
    41	            i for i in items if not store.is_sent(db, feed_cfg["name"], i["dedupe_key"])
    42	        )
    43	
    44	    fresh.sort(key=lambda i: i.get("published", ""), reverse=True)
    45	
    46	    sent = 0
    47	    sent_by_source = {}
    48	    for chan_cfg in cfg["channels"]:
    49	        selected = [i for i in fresh if matches(i, chan_cfg)]
    50	        if not selected:
    51	            continue
    52	        body = render.digest(selected, chan_cfg)
    53	        if dry_run:
    54	            print(f"--- would send to {chan_cfg['name']} ---")
    55	            print(body)
    56	            sent += len(selected)
    57	            continue
    58	        channels.send(chan_cfg, body)
    59	        sent += len(selected)
    60	        for item in selected:
    61	            sent_by_source.setdefault(item["source"], []).append(item)
    62	
    63	    for source, sent_items in sent_by_source.items():
    64	        store.mark_sent(db, source, sent_items)
    65	
    66	    return sent
    67	
    68	
    69	def main(argv=None):
    70	    ap = argparse.ArgumentParser(prog="digest")
