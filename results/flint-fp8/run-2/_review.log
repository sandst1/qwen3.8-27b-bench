1:"""SQLite persistence.
2:
3:The `items` table doubles as the seen-items ledger: an archive of everything
4:we have ever seen, and the record the digest loop consults to tell new items
5:from repeats. Only items that are not in the archive yet get dispatched.
6:"""
7:
8:import sqlite3
9:
10:SCHEMA = """
11:CREATE TABLE IF NOT EXISTS items (
12:    id          INTEGER PRIMARY KEY AUTOINCREMENT,
13:    source      TEXT NOT NULL,
14:    raw_id      TEXT,
15:    title       TEXT NOT NULL,
16:    link        TEXT NOT NULL,
17:    summary     TEXT,
18:    published   TEXT,
19:    first_seen  TEXT NOT NULL DEFAULT (datetime('now'))
20:);
21:
22:CREATE INDEX IF NOT EXISTS idx_items_source ON items(source);
23:"""
24:
25:
26:def connect(path):
27:    conn = sqlite3.connect(path)
28:    conn.row_factory = sqlite3.Row
29:    conn.executescript(SCHEMA)
30:    conn.commit()
31:    return conn
32:
33:
34:def item_key(source, item):
35:    """Identity of an item within a source: the feed's raw id when it has
36:    one, else the permalink. Blogroll posts have no raw id, so they key on
37:    their link instead."""
38:    return source, item.get("raw_id") or item["link"]
39:
40:
41:def unseen_items(conn, source, items):
42:    """The items from this source that are not in the archive yet."""
43:    fresh = []
44:    for item in items:
45:        key_source, key_value = item_key(source, item)
46:        row = conn.execute(
47:            "SELECT 1 FROM items WHERE source = ? AND COALESCE(raw_id, link) = ?",
48:            (key_source, key_value),
49:        ).fetchone()
50:        if row is None:
51:            fresh.append(item)
52:    return fresh
53:
54:
55:def record_items(conn, source, items):
56:    """Archive the given items. Callers pass only the items reported as new
57:    by `unseen_items`, so every real item ends up with exactly one row."""
58:    conn.executemany(
59:        "INSERT INTO items (source, raw_id, title, link, summary, published)"
60:        " VALUES (?, ?, ?, ?, ?, ?)",
61:        [
62:            (source, i["raw_id"], i["title"], i["link"], i.get("summary"), i.get("published"))
63:            for i in items
64:        ],
65:    )
66:    conn.commit()
67:
68:
69:def count_items(conn):
70:    return conn.execute("SELECT COUNT(*) AS n FROM items").fetchone()["n"]
