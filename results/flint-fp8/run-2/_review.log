1:#!/usr/bin/env python3
2:"""notify-digest — poll a few feeds, filter them, send digests to channels.
3:
4:Run from cron. See README.md.
5:
6:Each run only dispatches items that are new since the last run; the SQLite
7:archive in the store is the seen-items record, so unchanged feeds do not get
8:re-sent on every cron tick.
9:"""
10:
11:import argparse
12:import sys
13:import tomllib
14:from pathlib import Path
15:
16:import channels
17:import feeds
18:import render
19:import store
20:
21:
22:def load_config(path):
23:    with open(path, "rb") as fh:
24:        return tomllib.load(fh)
25:
26:
27:def matches(item, filt):
28:    """A channel filter is a list of keywords; empty list means 'everything'."""
29:    keywords = filt.get("keywords", [])
30:    if not keywords:
31:        return True
32:    haystack = (item["title"] + " " + item.get("summary", "")).lower()
33:    return any(k.lower() in haystack for k in keywords)
34:
35:
36:def run_once(cfg, db, dry_run=False):
37:    all_items = []
38:    for feed_cfg in cfg["feeds"]:
39:        try:
40:            items = feeds.fetch(feed_cfg)
41:        except feeds.FeedError as exc:
42:            print(f"warn: feed {feed_cfg['name']} failed: {exc}", file=sys.stderr)
43:            continue
44:        new_items = store.unseen_items(db, feed_cfg["name"], items)
45:        if not dry_run:
46:            store.record_items(db, feed_cfg["name"], new_items)
47:        all_items.extend(new_items)
48:
49:    all_items.sort(key=lambda i: i.get("published", ""), reverse=True)
50:
51:    sent = 0
52:    for chan_cfg in cfg["channels"]:
53:        selected = [i for i in all_items if matches(i, chan_cfg)]
54:        if not selected:
55:            continue
56:        body = render.digest(selected, chan_cfg)
57:        if dry_run:
58:            print(f"--- would send to {chan_cfg['name']} ---")
59:            print(body)
60:            continue
61:        channels.send(chan_cfg, body)
62:        sent += len(selected)
63:
64:    return sent
65:
66:
67:def main(argv=None):
68:    ap = argparse.ArgumentParser(prog="digest")
69:    ap.add_argument("--config", default="config.toml")
70:    ap.add_argument("--db", default="digest.sqlite3")
71:    ap.add_argument("--dry-run", action="store_true")
72:    args = ap.parse_args(argv)
73:
74:    cfg = load_config(args.config)
75:    db = store.connect(args.db)
76:    try:
77:        sent = run_once(cfg, db, dry_run=args.dry_run)
78:        print(f"sent {sent} items")
79:    finally:
80:        db.close()
81:    return 0
82:
83:
84:if __name__ == "__main__":
85:    raise SystemExit(main())
