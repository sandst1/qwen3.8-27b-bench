timestamp=2026-08-17T06:42:28.853Z level=INFO run=2151acf6 message=evaluated permission=bash pattern="python3 -c \"\nimport ast, sys, pathlib\nfor p in sorted(pathlib.Path('.').glob('*.py')):\n    tree = ast.parse(p.read_text())\n    src = p.read_text()\n    imported = set()\n    for n in ast.walk(tree):\n        if isinstance(n, ast.Import):\n            for a in n.names: imported.add((a.asname or a.name).split('.')[0])\n        elif isinstance(n, ast.ImportFrom):\n            for a in n.names: imported.add(a.asname or a.name)\n    used = {n.id for n in ast.walk(tree) if isinstance(n, ast.Name)} | {n.attr for n in ast.walk(tree) if isinstance(n, ast.Attribute)}\n    for n in ast.walk(tree):\n        if isinstance(n, ast.Attribute) and isinstance(n.value, ast.Name): used.add(n.value.id)\n    dead = imported - used\n    if dead: print(f'  {p}: unused import(s): {sorted(dead)}')\nprint('  (none reported above = clean)')\"" action.permission=* action.action=allow action.pattern=*
