import sys
sys.path.insert(0, ".")
import store, feeds, channels, digest

cfg = digest.load_config("config.toml")
db = store.connect(":memory:")

orig_send = channels.send
def flaky_send(chan_cfg, body):
    if chan_cfg["name"] == "energy":
        raise channels.DeliveryError("energy webhook down")
    return orig_send(chan_cfg, body)
channels.send = flaky_send

try:
    sent = digest.run_once(cfg, db, dry_run=False)
    print("sent:", sent)
except channels.DeliveryError as e:
    print("run crashed with:", e)

print("--- deliveries table ---")
for row in db.execute("SELECT * FROM deliveries"):
    print(dict(row))
EOF
