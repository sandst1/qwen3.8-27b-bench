python3 -c "
import tomllib, sys
sys.path.insert(0,'.')
import store, digest, channels

cfg = tomllib.load(open('config.toml','rb'))
# make 'ops' a broken webhook to simulate failure
cfg['channels'][0]['type'] = 'webhook'
cfg['channels'][0]['url'] = 'http://127.0.0.1:1/nope'  # nothing listening -> connection refused

db = store.connect('digest.sqlite3')
try:
    sent = digest.run_once(cfg, db, dry_run=False)
    print('sent', sent)
except Exception as e:
    print('EXCEPTION:', repr(e))
    print('deliveries after failure:', db.execute('select channel, dedup_key from deliveries').fetchall())
db.close()
"

