import tomllib, sys
sys.path.insert(0,'.')
import store, digest

cfg = tomllib.load(open('config.toml','rb'))
cfg['channels'][0]['type'] = 'webhook'
cfg['channels'][0]['url'] = 'http://127.0.0.1:1/nope'

db = store.connect('digest.sqlite3')
try:
    digest.run_once(cfg, db, dry_run=False)
except Exception as e:
    pass
# now fix ops back to stdout and rerun -- does energy/everything get sent now (delayed)?
cfg['channels'][0]['type'] = 'stdout'
sent = digest.run_once(cfg, db, dry_run=False)
print('sent on retry', sent)
db.close()
"

