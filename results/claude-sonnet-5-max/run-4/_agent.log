timestamp=2026-08-17T07:14:16.709Z level=INFO run=f4be80fc message=evaluated permission=bash pattern="python3 -c \"\nimport feeds\n\n# Same story, tracking params differ across crawls -> same dedup_key\na = feeds._dedup_key('newsroom', 'https://newsroom.example/2026/08/port-fees?utm_source=feed&utm_campaign=w33')\nb = feeds._dedup_key('newsroom', 'https://newsroom.example/2026/08/port-fees?utm_source=feed&utm_campaign=w34')\nassert a == b, (a, b)\nprint('OK: utm churn collapses to same key ->', a)\n\n# Wire: guid changes on edit but link is stable -> same dedup_key\nc = feeds._dedup_key('wire', 'https://wire.example/i/0031')\nd = feeds._dedup_key('wire', 'https://wire.example/i/0031')\nassert c == d\nprint('OK: wire link-based key stable ->', c)\n\n# Different underlying stories -> different keys\ne = feeds._dedup_key('newsroom', 'https://newsroom.example/2026/08/port-fees-union?utm_source=feed&utm_campaign=w34')\nassert e != a\nprint('OK: genuinely different story gets different key ->', e)\n\n# Query param order churn (non-tracking params) still normalizes the same\nf1 = feeds._dedup_key('x', 'https://example/a?id=5&ref=y')\nf2 = feeds._dedup_key('x', 'https://example/a?ref=y&id=5')\nassert f1 == f2\nprint('OK: non-tracking param order does not matter ->', f1)\n\"" action.permission=* action.action=allow action.pattern=*
