import store, feeds, digest, channels

cfg = digest.load_config('config.toml')
db = store.connect('/tmp/nd_fail_test.sqlite3')

orig_send = channels.send
calls = []
def flaky_send(chan_cfg, body):
    calls.append(chan_cfg['name'])
    if chan_cfg['name'] == 'energy':
        raise channels.DeliveryError('simulated outage')
    return orig_send(chan_cfg, body)
channels.send = flaky_send

try:
    sent = digest.run_once(cfg, db)
except channels.DeliveryError as e:
    print('caught expected error:', e)

print('calls made:', calls)
rows = db.execute('select channel, dedupe_key from deliveries').fetchall()
print('deliveries recorded:', [(r[0]) for r in rows])
"

