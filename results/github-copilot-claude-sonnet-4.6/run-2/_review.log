[0m$ [0mcd /tmp/notify-test && python3 - <<'EOF'
import sqlite3
import tomllib
import sys
sys.path.insert(0, '.')
import store, feeds, channels

cfg = tomllib.load(open("config.toml", "rb"))
db = store.connect("digest_crash_test.sqlite3")

# Simulate: fetch happens, record_new_items marks them seen, THEN delivery fails.
feed_cfg = cfg["feeds"][0]
items = feeds.fetch(feed_cfg)
print("fetched", len(items), "items from", feed_cfg["name"])
new_items = store.record_new_items(db, feed_cfg["name"], items)
print("marked as seen (new):", len(new_items))

# Now simulate a channel send failure (as would happen with a webhook down)
class FakeFail(Exception): pass
try:
    raise FakeFail("webhook unreachable")
except FakeFail as e:
    print("delivery crashed:", e)

# Next cron tick: re-fetch same feed. Are the 'lost' items recoverable?
items2 = feeds.fetch(feed_cfg)
new_items2 = store.record_new_items(db, feed_cfg["name"], items2)
print("On retry (same feed data), items considered new:", len(new_items2))
print("--> those items were marked seen but NEVER actually delivered. They are gone for good.")
EOF

