32:def run_once(cfg, db, dry_run=False):
33:    """One digest run: fetch, then send each channel only its unseen news.
34:
35:    Feeds re-serve their rolling window on every fetch, so "just fetched"
36:    does not mean "new". Each channel's digest is filtered against the
37:    ledger of what that channel has already received (store.py), and the
38:    ledger is only written after a successful send — if delivery dies
39:    mid-run, nothing is marked and the next cron tick retries (see
40:    channels.py).
41:    """
54:    for chan_cfg in cfg["channels"]:
55:        already = store.sent_keys(db, chan_cfg["name"])
56:        selected = [
57:            i
58:            for i in all_items
59:            if feeds.item_key(i) not in already and matches(i, chan_cfg)
60:        ]
61:        if not selected:
62:            continue
63:        body = render.digest(selected, chan_cfg)
64:        if dry_run:
65:            print(f"--- would send to {chan_cfg['name']} ---")
66:            print(body)
67:            continue
68:        channels.send(chan_cfg, body)
69:        store.record_sent(db, chan_cfg["name"], [(feeds.item_key(i), i) for i in selected])
70:        sent += len(selected)
