90:def item_key(item):
91:    """Stable identity of an item across fetches.
92:
93:    Keyed on source + link host/path, because neither field you would
94:    naively reach for is stable in our feeds:
95:
96:    - the generic provider regenerates the guid whenever an item is edited
97:      (see "wire-...-r2" in fixtures/snapshot-b), so guid == new is wrong;
98:    - the newsroom rotates the utm_* tracking params in its URLs between
99:      snapshots, so the full URL (and its hash) is not stable either.
100:
101:    An item re-published at the same URL after an edit is deliberately not
102:    treated as new news. Feeds that ship an empty link fall back to
103:    raw_id/title so their keys stay distinct instead of colliding on "".
104:    """
105:    link = (item.get("link") or "").strip()
106:    if link:
107:        parts = urlsplit(link)
108:        ident = f"{parts.netloc.lower()}{parts.path.rstrip('/')}"
109:    else:
110:        ident = item.get("raw_id") or item.get("title", "")
111:    return f"{item['source']}|{ident}"
