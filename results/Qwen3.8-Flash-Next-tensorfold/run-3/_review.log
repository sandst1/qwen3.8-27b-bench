import sys
sys.path.insert(0,".")
import store, digest, tomllib

cfg = tomllib.load(open("config.toml","rb"))
db = store.connect("newchannel-test.sqlite3")

# First run with original 3 channels - seeds ledger, sends everything once.
sent1 = digest.run_once(cfg, db, dry_run=False)
print("run1 sent:", sent1)

# Second run, same config/snapshot - nothing new.
sent2 = digest.run_once(cfg, db, dry_run=False)
print("run2 sent (should be 0):", sent2)

# Now add a new channel 'urgent' with a broad keyword that matches lots of the
# ALREADY-ARCHIVED items (simulating someone adding a channel after go-live).
cfg["channels"].append({"name": "urgent", "type": "stdout", "title": "Urgent", "keywords": ["port"]})
sent3 = digest.run_once(cfg, db, dry_run=False)
print("run3 sent after adding 'urgent' channel (items it receives on its first run):", sent3)
