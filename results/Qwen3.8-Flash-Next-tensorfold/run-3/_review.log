python3 - <<'EOF'
import sys, json
sys.path.insert(0, ".")
import store, feeds, digest, tomllib

cfg = tomllib.load(open("config.toml","rb"))
db = store.connect("overseed-test2.sqlite3")  # reuse state from previous script

# Now simulate the SAME blogroll post being edited to ALSO be relevant to
# the energy desk (same link => same identity, broadened content), e.g. a
# follow-up paragraph linking the port levy to the regional power grid.
import feeds as feeds_mod
blog_items = feeds.fetch(cfg["feeds"][1])  # blogroll feed_cfg
for it in blog_items:
    if "arithmetic" in it["link"]:
        it["title"] = "Notes on port fee arithmetic, now covering the grid tie-in"
        it["summary"] = "Working through the levy numbers and the offshore grid angle."

class FakeFeedsModule:
    @staticmethod
    def fetch(feed_cfg):
        if feed_cfg["name"] == "blogroll":
            return blog_items
        return feeds.fetch(feed_cfg)
    FeedError = feeds.FeedError

digest.feeds = FakeFeedsModule
sent = digest.run_once(cfg, db, dry_run=False)
print("sent on this tick (expect the broadened post to reach 'energy' too):", sent)
