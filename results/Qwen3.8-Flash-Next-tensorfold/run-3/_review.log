import sys
sys.path.insert(0, ".")
import store, feeds, digest, tomllib, channels

cfg = tomllib.load(open("config.toml","rb"))
db = store.connect("fail-test.sqlite3")

orig_send = channels.send
calls = []
def flaky_send(chan_cfg, body):
    calls.append(chan_cfg["name"])
    if chan_cfg["name"] == "energy":
        raise channels.DeliveryError("simulated failure")
    return orig_send(chan_cfg, body)
channels.send = flaky_send

try:
    sent = digest.run_once(cfg, db, dry_run=False)
    print("completed without exception, sent=", sent)
except channels.DeliveryError as e:
    print("crashed as expected:", e)

print("delivered rows:", db.execute("select channel, count(*) from delivered group by channel").fetchall())
db.close()
EOF

