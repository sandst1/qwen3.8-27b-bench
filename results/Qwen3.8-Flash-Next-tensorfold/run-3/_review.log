     1	"""SQLite persistence: an archive, and the ledger that stops repeat sends.
     2	
     3	Two tables:
     4	
     5	`items`     Archive of everything ever fetched, one row per (feed, URL)
     6	            seen. Nothing in the send path reads it; it exists to answer
     7	            "did this ever come through?" when someone asks.
     8	
     9	`delivered` Delivery ledger: one row per (channel, source, key) that a
    10	            digest has already carried for that channel. Feeds re-list
    11	            their back-catalogue on every fetch and cron ticks every 15
    12	            minutes, so without this ledger every digest re-sends the
    13	            whole feed window. An item may match several channels'
    14	            filters and then appear once in each of their digests --
    15	            channels are independent views, which keeps digest content
    16	            from depending on channel order in the config file.
    17	
    18	An item is identified by its `key` -- its link normalised via `identity`.
    19	Never by the id the feed provides: see `identity` for why ids and raw
    20	URLs cannot be trusted.
    21	"""
    22	
    23	import sqlite3
    24	from urllib.parse import urlsplit, urlunsplit
    25	
    26	SCHEMA = """
    27	CREATE TABLE IF NOT EXISTS items (
    28	    id          INTEGER PRIMARY KEY AUTOINCREMENT,
    29	    source      TEXT NOT NULL,
    30	    raw_id      TEXT,
    31	    title       TEXT NOT NULL,
    32	    link        TEXT NOT NULL,
    33	    summary     TEXT,
    34	    published   TEXT,
    35	    first_seen  TEXT NOT NULL DEFAULT (datetime('now'))
    36	);
    37	
    38	CREATE INDEX IF NOT EXISTS idx_items_source ON items(source);
    39	
    40	CREATE TABLE IF NOT EXISTS delivered (
    41	    channel  TEXT NOT NULL,
    42	    source   TEXT NOT NULL,
    43	    key      TEXT NOT NULL,
    44	    sent_at  TEXT NOT NULL DEFAULT (datetime('now')),
    45	    PRIMARY KEY (channel, source, key)
    46	);
    47	"""
    48	
    49	
    50	def connect(path):
    51	    conn = sqlite3.connect(path)
    52	    conn.row_factory = sqlite3.Row
    53	    conn.executescript(SCHEMA)
    54	    conn.commit()
    55	    return conn
    56	
    57	
    58	def identity(link):
    59	    """The dedup key for an item: its link with scheme/host lower-cased and
    60	    the query string and fragment stripped.
    61	
    62	    Ids cannot key anything (the `generic` provider regenerates its guid
    63	    whenever an item is edited, the `blogroll` provider has none), and the
    64	    raw link is not stable either: the newsroom provider rotates utm_
    65	    tracking tags in the query string between weeks -- fixtures/snapshot-a
    66	    vs snapshot-b show the same story arriving once with utm_campaign=w33
    67	    and once with w34. Keying on the stripped link makes those one item.
    68	
    69	    Trade-off to revisit if a new feed ever keys real content in the query
    70	    string (`/view?article=123`-style URLs): this rule would fold such
    71	    distinct articles together. None of the three current providers does.
    72	    """
    73	    parts = urlsplit(link)
    74	    return urlunsplit((parts.scheme.lower(), parts.netloc.lower(), parts.path, "", ""))
    75	
    76	
    77	def record_items(conn, source, items):
    78	    """Archive freshly fetched items, skipping ones already on file.
    79	
    80	    Feeds re-list the same items for as long as they stay in the feed's
    81	    window; one archive row per item keeps "did this ever come through?"
    82	    answerable without growing the database every tick.
    83	    """
    84	    have = {identity(r["link"]) for r in
    85	            conn.execute("SELECT link FROM items WHERE source = ?", (source,))}
    86	    rows = []
    87	    for i in items:
    88	        key = identity(i["link"])
    89	        if key in have:
    90	            continue
    91	        have.add(key)
    92	        rows.append(
    93	            (source, i["raw_id"], i["title"], i["link"], i.get("summary"), i.get("published"))
    94	        )
    95	    conn.executemany(
    96	        "INSERT INTO items (source, raw_id, title, link, summary, published)"
    97	        " VALUES (?, ?, ?, ?, ?, ?)",
    98	        rows,
    99	    )
   100	    conn.commit()
   101	
   102	
   103	def delivered_keys(conn, channel):
   104	    """(source, key) pairs this channel has already received."""
   105	    return {
   106	        (r["source"], r["key"])
   107	        for r in conn.execute("SELECT source, key FROM delivered WHERE channel = ?", (channel,))
   108	    }
   109	
   110	
   111	def mark_delivered(conn, channel, items):
   112	    conn.executemany(
   113	        "INSERT OR IGNORE INTO delivered (channel, source, key) VALUES (?, ?, ?)",
   114	        [(channel, i["source"], identity(i["link"])) for i in items],
   115	    )
   116	    conn.commit()
   117	
   118	
   119	def seed_ledger(conn, channels):
   120	    """One-time upgrade step: treat the old archive as already delivered.
   121	
   122	    Before the dedup fix, every cron run re-sent the whole feed window to
   123	    every channel whose filter matched, so anything already sitting in
   124	    `items` had in fact already been sent to everyone many times over.
   125	    Without this seed, the first run *with* the fix would deliver that
   126	    whole stale window one final time -- the exact spam people complained
   127	    about. A database created by the fixed version starts with an empty
   128	    `delivered` table, so nothing is suppressed on the very first run: a
   129	    fresh install legitimately sees the current feed window as new.
   130	
   131	    The seeded rows are bookkeeping marks, not real sends (their sent_at is
   132	    the seed timestamp); the ledger is deliberately not used for anything
   133	    beyond dedup, which is why that shortcut is safe.
   134	    """
   135	    if conn.execute("SELECT 1 FROM delivered LIMIT 1").fetchone():
   136	        return
   137	    archived = conn.execute("SELECT source, link FROM items").fetchall()
   138	    if not archived:
   139	        return
   140	    conn.executemany(
   141	        "INSERT OR IGNORE INTO delivered (channel, source, key) VALUES (?, ?, ?)",
   142	        [
   143	            (name, r["source"], identity(r["link"]))
   144	            for name in channels
   145	            for r in archived
