python3 - <<'EOF'
import sys
sys.path.insert(0, '.')
import digest, store, channels

cfg_a = digest.load_config('config-a.toml')
db = store.connect('digest.sqlite3')

calls = []
orig_send = channels.send
def flaky_send(chan_cfg, body):
    calls.append(chan_cfg['name'])
    if chan_cfg['name'] == 'energy':
        raise channels.DeliveryError("energy down")
    return orig_send(chan_cfg, body)

digest.channels.send = flaky_send
try:
    digest.run_once(cfg_a, db)
except channels.DeliveryError as e:
    print("raised:", e)
print("calls so far:", calls)
print("delivered rows:", db.execute("select channel, item_key from delivered").fetchall())
db.close()
EOF
