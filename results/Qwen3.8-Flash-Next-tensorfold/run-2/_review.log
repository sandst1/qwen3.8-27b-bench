1:#!/usr/bin/env python3
2:"""notify-digest — poll a few feeds, filter them, send digests to channels.
3:
4:Run from cron. See README.md.
5:"""
6:
7:import argparse
8:import sys
9:import tomllib
10:from pathlib import Path
11:
12:import channels
13:import feeds
14:import render
15:import store
16:
17:
18:def load_config(path):
19:    with open(path, "rb") as fh:
20:        return tomllib.load(fh)
21:
22:
23:def matches(item, filt):
24:    """A channel filter is a list of keywords; empty list means 'everything'."""
25:    keywords = filt.get("keywords", [])
26:    if not keywords:
27:        return True
28:    haystack = (item["title"] + " " + item.get("summary", "")).lower()
29:    return any(k.lower() in haystack for k in keywords)
30:
31:
32:def run_once(cfg, db, dry_run=False):
33:    all_items = []
34:    for feed_cfg in cfg["feeds"]:
35:        try:
36:            items = feeds.fetch(feed_cfg)
37:        except feeds.FeedError as exc:
38:            print(f"warn: feed {feed_cfg['name']} failed: {exc}", file=sys.stderr)
39:            continue
40:        all_items.extend(items)
41:
42:    all_items.sort(key=lambda i: i.get("published", ""), reverse=True)
43:
44:    sent = 0
45:    for chan_cfg in cfg["channels"]:
46:        # Send only what this channel has not received before. The ledger
47:        # is per channel and keyed on a normalised URL, not on the feed's
48:        # item id; store.py's docstring explains why and feeds.py names
49:        # the provider quirks that force it.
50:        seen = store.delivered_keys(db, chan_cfg["name"])
51:        selected = [
52:            i
53:            for i in all_items
54:            if store.item_key(i) not in seen and matches(i, chan_cfg)
55:        ]
56:        if not selected:
57:            continue
58:        body = render.digest(selected, chan_cfg)
59:        if dry_run:
60:            print(f"--- would send to {chan_cfg['name']} ---")
61:            print(body)
62:            continue
63:        # If the send raises, nothing is recorded and the next cron tick
64:        # retries these items.
65:        channels.send(chan_cfg, body)
66:        store.mark_delivered(db, chan_cfg["name"], selected)
67:        sent += len(selected)
68:
69:    return sent
70:
71:
72:def main(argv=None):
73:    ap = argparse.ArgumentParser(prog="digest")
74:    ap.add_argument("--config", default="config.toml")
75:    ap.add_argument("--db", default="digest.sqlite3")
76:    ap.add_argument("--dry-run", action="store_true")
77:    args = ap.parse_args(argv)
78:
79:    cfg = load_config(args.config)
80:    db = store.connect(args.db)
81:    try:
82:        deliveries = run_once(cfg, db, dry_run=args.dry_run)
83:        print(f"sent {deliveries} channel-item deliveries")
84:    finally:
85:        db.close()
86:    return 0
87:
88:
89:if __name__ == "__main__":
90:    raise SystemExit(main())
