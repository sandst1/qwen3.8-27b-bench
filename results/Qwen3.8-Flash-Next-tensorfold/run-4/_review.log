1:"""SQLite persistence.
2:
3:Two tables:
4:
5:`items` — an archive of every fetch, so we can answer "did this ever come
6:through?" when someone asks.
7:
8:`delivered` — the delivery ledger, one row per (channel, item) that was
9:successfully sent to a channel. run_once() consults it so that each
10:repeated item is skipped on later runs and delivery stops being spam.
11:
12:Identity: an item is identified by (source, canonical link), NOT by its
13:provider id and NOT by its title/title+link, because the ids we get are not
14:stable across repeats — the wire provider regenerates its guid whenever an
15:item is edited, and newsroom appends a rotating utm_campaign to its urls —
16:while title and link are stable. That is why we normalise the link (drop
17:query, fragment, trailing slash) before comparing and why title is not part
18:of the key: an edited or retitled story at the same link is the same story.
19:If the link is ever empty we fall back to raw_id, then title.
20:
21:Ledger rows are written only after a successful send, so if delivery to a
22:channel fails the items are retried on the next tick instead of being
23:silently consumed.
24:"""
25:
26:import sqlite3
27:
28:SCHEMA = """
29:CREATE TABLE IF NOT EXISTS items (
30:    id          INTEGER PRIMARY KEY AUTOINCREMENT,
31:    source      TEXT NOT NULL,
32:    raw_id      TEXT,
33:    title       TEXT NOT NULL,
34:    link        TEXT NOT NULL,
35:    summary     TEXT,
36:    published   TEXT,
37:    first_seen  TEXT NOT NULL DEFAULT (datetime('now'))
38:);
39:
40:CREATE INDEX IF NOT EXISTS idx_items_source ON items(source);
41:
42:CREATE TABLE IF NOT EXISTS delivered (
43:    channel  TEXT NOT NULL,
44:    source   TEXT NOT NULL,
45:    link     TEXT NOT NULL,
46:    sent_at  TEXT NOT NULL DEFAULT (datetime('now')),
47:    PRIMARY KEY (channel, source, link)
48:);
49:"""
50:
51:
52:def connect(path):
53:    conn = sqlite3.connect(path)
54:    conn.row_factory = sqlite3.Row
55:    conn.executescript(SCHEMA)
56:    conn.commit()
57:    return conn
58:
59:
60:def record_items(conn, source, items):
61:    conn.executemany(
62:        "INSERT INTO items (source, raw_id, title, link, summary, published)"
63:        " VALUES (?, ?, ?, ?, ?, ?)",
64:        [
65:            (source, i["raw_id"], i["title"], i["link"], i.get("summary"), i.get("published"))
66:            for i in items
67:        ],
68:    )
69:    conn.commit()
70:
71:
72:def count_items(conn):
73:    return conn.execute("SELECT COUNT(*) AS n FROM items").fetchone()["n"]
74:
75:
76:def item_key(item):
77:    """The (source, canonical link) pair identifying an item. See module docstring."""
78:    link = item["link"].split("#", 1)[0].split("?", 1)[0].rstrip("/")
79:    if not link:
80:        link = item.get("raw_id") or item["title"]
81:    return (item["source"], link)
82:
83:
84:def was_delivered(conn, channel, item):
85:    source, link = item_key(item)
86:    row = conn.execute(
87:        "SELECT 1 FROM delivered WHERE channel = ? AND source = ? AND link = ?",
88:        (channel, source, link),
89:    ).fetchone()
90:    return row is not None
91:
92:
93:def mark_delivered(conn, channel, items):
94:    conn.executemany(
95:        "INSERT OR IGNORE INTO delivered (channel, source, link) VALUES (?, ?, ?)",
96:        [(channel, *item_key(i)) for i in items],
97:    )
98:    conn.commit()
