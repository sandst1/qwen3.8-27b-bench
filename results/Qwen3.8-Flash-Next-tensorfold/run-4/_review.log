1:#!/usr/bin/env python3
2:"""notify-digest — poll a few feeds, filter them, send digests to channels.
3:
4:Run from cron. See README.md.
5:"""
6:
7:import argparse
8:import sys
9:import tomllib
10:from pathlib import Path
11:
12:import channels
13:import feeds
14:import render
15:import store
16:
17:
18:def load_config(path):
19:    with open(path, "rb") as fh:
20:        return tomllib.load(fh)
21:
22:
23:def matches(item, filt):
24:    """A channel filter is a list of keywords; empty list means 'everything'."""
25:    keywords = filt.get("keywords", [])
26:    if not keywords:
27:        return True
28:    haystack = (item["title"] + " " + item.get("summary", "")).lower()
29:    return any(k.lower() in haystack for k in keywords)
30:
31:
32:def run_once(cfg, db, dry_run=False):
33:    all_items = []
34:    for feed_cfg in cfg["feeds"]:
35:        try:
36:            items = feeds.fetch(feed_cfg)
37:        except feeds.FeedError as exc:
38:            print(f"warn: feed {feed_cfg['name']} failed: {exc}", file=sys.stderr)
39:            continue
40:        store.record_items(db, feed_cfg["name"], items)
41:        all_items.extend(items)
42:
43:    all_items.sort(key=lambda i: i.get("published", ""), reverse=True)
44:
45:    # Feeds mostly repeat their current contents on every poll, so each
46:    # channel only gets items it has never been sent before, tracked per
47:    # channel via the delivery ledger (see the store module docstring for
48:    # what counts as "the same item"). Items are marked after a successful
49:    # send only: a failed send aborts the run, and the next cron tick
50:    # retries what never got through.
51:    sent = 0
52:    for chan_cfg in cfg["channels"]:
53:        name = chan_cfg["name"]
54:        selected = [
55:            i
56:            for i in all_items
57:            if matches(i, chan_cfg) and not store.was_delivered(db, name, i)
58:        ]
59:        if not selected:
60:            continue
61:        body = render.digest(selected, chan_cfg)
62:        if dry_run:
63:            print(f"--- would send to {name} ---")
64:            print(body)
65:            continue
66:        channels.send(chan_cfg, body)
67:        store.mark_delivered(db, name, selected)
68:        sent += len(selected)
69:
70:    return sent
71:
72:
73:def main(argv=None):
74:    ap = argparse.ArgumentParser(prog="digest")
75:    ap.add_argument("--config", default="config.toml")
76:    ap.add_argument("--db", default="digest.sqlite3")
77:    ap.add_argument("--dry-run", action="store_true")
78:    args = ap.parse_args(argv)
79:
80:    cfg = load_config(args.config)
81:    db = store.connect(args.db)
82:    try:
83:        sent = run_once(cfg, db, dry_run=args.dry_run)
84:        print(f"sent {sent} items")
85:    finally:
86:        db.close()
87:    return 0
88:
89:
90:if __name__ == "__main__":
91:    raise SystemExit(main())
