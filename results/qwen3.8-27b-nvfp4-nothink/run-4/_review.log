import sys
sys.path.insert(0, ".")
import store, digest, feeds, channels, render

cfg = digest.load_config("config-crash.toml")
db = store.connect("digest-crash.sqlite3")

# monkeypatch channels.send: succeed for "ops", raise for "energy"
orig_send = channels.send
def flaky_send(chan_cfg, body):
    if chan_cfg["name"] == "energy":
        raise channels.DeliveryError("simulated crash on energy channel")
    return orig_send(chan_cfg, body)
channels.send = flaky_send

try:
    sent = digest.run_once(cfg, db, dry_run=False)
    print("sent", sent)
except Exception as e:
    print("crashed:", e)

db.close()
EOF
