1:#!/usr/bin/env python3
2:"""notify-digest — poll a few feeds, filter them, send digests to channels.
3:
4:Each channel only receives items it has not already been sent; the ledger
5:lives in SQLite. See "How duplicates are prevented" in README.md.
6:
7:Run from cron. See README.md.
8:"""
9:
10:import argparse
11:import sys
12:import tomllib
13:from pathlib import Path
14:
15:import channels
16:import feeds
17:import render
18:import store
19:
20:
21:def load_config(path):
22:    with open(path, "rb") as fh:
23:        return tomllib.load(fh)
24:
25:
26:def matches(item, filt):
27:    """A channel filter is a list of keywords; empty list means 'everything'."""
28:    keywords = filt.get("keywords", [])
29:    if not keywords:
30:        return True
31:    haystack = (item["title"] + " " + item.get("summary", "")).lower()
32:    return any(k.lower() in haystack for k in keywords)
33:
34:
35:def run_once(cfg, db, dry_run=False):
36:    all_items = []
37:    for feed_cfg in cfg["feeds"]:
38:        try:
39:            items = feeds.fetch(feed_cfg)
40:        except feeds.FeedError as exc:
41:            print(f"warn: feed {feed_cfg['name']} failed: {exc}", file=sys.stderr)
42:            continue
43:        store.record_items(db, items)
44:        all_items.extend(items)
45:
46:    all_items.sort(key=lambda i: i.get("published", ""), reverse=True)
47:
48:    sent = 0
49:    for chan_cfg in cfg["channels"]:
50:        already = store.delivered_uids(db, chan_cfg["name"])
51:        selected = [
52:            i for i in all_items if i["uid"] not in already and matches(i, chan_cfg)
53:        ]
54:        if not selected:
55:            continue
56:        body = render.digest(selected, chan_cfg)
57:        if dry_run:
58:            print(f"--- would send to {chan_cfg['name']} ---")
59:            print(body)
60:            continue
61:        channels.send(chan_cfg, body)
62:        # Mark only after a successful send: if delivery fails the
63:        # exception propagates and the items go out on the next tick.
64:        store.mark_delivered(db, chan_cfg["name"], [i["uid"] for i in selected])
65:        sent += len(selected)
66:
67:    return sent
68:
69:
70:def main(argv=None):
71:    ap = argparse.ArgumentParser(prog="digest")
72:    ap.add_argument("--config", default="config.toml")
73:    ap.add_argument("--db", default="digest.sqlite3")
74:    ap.add_argument("--dry-run", action="store_true")
75:    args = ap.parse_args(argv)
76:
77:    cfg = load_config(args.config)
78:    db = store.connect(args.db)
79:    try:
80:        sent = run_once(cfg, db, dry_run=args.dry_run)
81:        print(f"sent {sent} items")
82:    finally:
83:        db.close()
84:    return 0
85:
86:
87:if __name__ == "__main__":
88:    raise SystemExit(main())
