import sys
sys.path.insert(0, '.')
import digest, store, channels

cfg = digest.load_config('config.example.toml')
cfg['channels'] = [
    {"name": "ops", "type": "stdout", "title": "Ops", "keywords": ["port"]},
    {"name": "energy", "type": "webhook", "url": "http://127.0.0.1:9/nope", "title": "Energy", "keywords": ["tender"]},
    {"name": "everything", "type": "stdout", "title": "Firehose", "keywords": []},
]
db = store.connect("fail_test.sqlite3")
try:
    sent = digest.run_once(cfg, db)
    print("sent", sent)
except Exception as e:
    print("EXCEPTION:", e)
print("ops delivered:", store.delivered_uids(db, "ops"))
print("energy delivered:", store.delivered_uids(db, "energy"))
print("everything delivered:", store.delivered_uids(db, "everything"))
db.close()
EOF
