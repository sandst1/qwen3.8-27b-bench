1:"""Feed loading.
2:
3:Feeds are JSON documents. Remote feeds are fetched over HTTP; local ones
4:(used in development and in the fixtures/ directory) are read from disk.
5:
6:The three providers we currently pull from do not agree on much, so this
7:module normalises them into a common item shape:
8:
9:    {"title": str, "link": str, "summary": str, "published": str,
10:     "source": str, "raw_id": str | None, "uid": str}
11:
12:Identifying items across runs
13:-----------------------------
14:Each item gets a `uid` ("<source>|<key>") used to decide what counts as
15:"already seen". The providers make this awkward, so the key is chosen
16:per feed via the `dedupe_by` config option:
17:
18:    newsroom  entry_id is stable, but the URL carries a utm_campaign that
19:              rotates weekly -> dedupe_by = "raw_id"
20:    generic   guid is regenerated whenever an item is edited (see the two
21:              wire fixtures), while the link never changes -> dedupe_by = "link"
22:    blogroll  no identifier of any kind -> dedupe_by = "link"
23:
24:The default is "link", which is the only field present and stable in every
25:format; a feed sets "raw_id" only when its provider guarantees the id. If
26:raw_id is missing we fall back to link.
27:
28:Consequence we accept on purpose: an edited item (retitled blog post,
29:corrected wire story) is NOT re-sent. Missing an edit is better than
30:re-notifying everyone every time a provider touches a story.
31:"""
32:
33:import json
34:import urllib.error
35:import urllib.request
===
1:"""SQLite persistence.
2:
3:Two tables:
4:
5:`items` is an archive of everything we have ever seen, keyed by a unique
6:`uid` (see feeds.py for how identity is decided). Inserting an item we
7:already archived is a no-op.
8:
9:`deliveries` is the dedup ledger: one row per (channel, uid), written only
10:after a channel's digest has been sent successfully. This is what stops
11:people getting the same items every 15 minutes. It is per channel, so an
12:item matching two channels is still delivered to both, and because rows
13:are written after a successful send, a channel whose webhook was down
14:retries on the next cron tick.
15:"""
16:
17:import sqlite3
18:
19:SCHEMA = """
20:CREATE TABLE IF NOT EXISTS items (
50:    return conn
51:
52:
53:def _migrate(conn):
54:    """Upgrade databases created before items had a uid column.
55:
56:    Old archives contain the same item many times (that was the bug), so
57:    we backfill a uid, drop the duplicate rows, and only then let SCHEMA
58:    add the unique index. We backfill from the link rather than raw_id:
59:    for old wire rows the guid may already have changed, but the worst
60:    case is that a handful of items get sent one last time.
61:    """
62:    cols = {row["name"] for row in conn.execute("PRAGMA table_info(items)")}
63:    if not cols or "uid" in cols:
64:        return
65:    conn.execute("ALTER TABLE items ADD COLUMN uid TEXT")
66:    conn.execute("UPDATE items SET uid = source || '|' || link")
67:    conn.execute(
68:        "DELETE FROM items WHERE id NOT IN"
69:        " (SELECT MIN(id) FROM items GROUP BY uid)"
70:    )
71:    conn.commit()
72:
73:
74:def record_items(conn, items):
75:    conn.executemany(
76:        "INSERT OR IGNORE INTO items (uid, source, raw_id, title, link, summary, published)"
77:        " VALUES (?, ?, ?, ?, ?, ?, ?)",
78:        [
79:            (
80:                i["uid"],
81:                i["source"],
82:                i["raw_id"],
83:                i["title"],
84:                i["link"],
85:                i.get("summary"),
86:                i.get("published"),
87:            )
88:            for i in items
89:        ],
90:    )
